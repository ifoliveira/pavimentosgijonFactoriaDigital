{% extends 'layouts/base_public.html.twig' %}
{% set page_title = page_title|default('Presupuesto de cambio de bañera por ducha | Nueva versión') %}
{% set page_meta_description = page_meta_description|default('Calcula un presupuesto de cambio de bañera por plato de ducha con el nuevo configurador BudgetFlow.') %}
{% set flow_heading = flow_heading|default('Cambio de bañera por plato de ducha') %}
{% set intro_message = intro_message|default('Vamos a calcular tu cambio de bañera por plato de ducha.') %}
{% set api_base = api_base|default('/api/presupuesto-ducha') %}

{% block title %}{{ page_title }}{% endblock %}
{% block meta_description %}{{ page_meta_description }}{% endblock %}

{% block body %}
<div class="ducha-flow">
  <section class="ducha-flow__panel">
    <div class="ducha-flow__header">
      <p>Presupuesto online</p>
      <h1>{{ flow_heading }}</h1>
    </div>

    <div id="ducha-chat" class="ducha-chat" aria-live="polite"></div>

    <div id="ducha-options" class="ducha-options" hidden></div>

    <form id="ducha-form" class="ducha-form">
      <input id="ducha-input" type="text" autocomplete="off" placeholder="Escribe tu respuesta..." />
      <button type="submit">Enviar</button>
    </form>

    <form id="ducha-lead-form" class="ducha-lead-form" hidden>
      <h2>Tu presupuesto está listo</h2>
      <p>Déjanos tu correo electrónico y te enviaremos un enlace para que puedas consultarlo cuando quieras.</p>
      <p>También podremos escribirte durante los próximos días únicamente para hacer seguimiento de este presupuesto. En cualquier momento podrás indicarnos que no deseas recibir más mensajes y cerraremos el seguimiento.</p>

      <label for="ducha-lead-email">Correo electrónico</label>
      <input id="ducha-lead-email" name="email" type="email" autocomplete="email" required />

      <label class="ducha-privacy">
        <input id="ducha-lead-privacy" name="privacidad" type="checkbox" required />
        <span>He leído la <a href="{{ path('politica_privacidad') }}" target="_blank" rel="noopener">Política de privacidad</a> y la información sobre el tratamiento de mis datos.</span>
      </label>

      <div id="ducha-lead-error" class="ducha-lead-error" role="alert" hidden></div>
      <button type="submit">Enviarme mi presupuesto</button>
    </form>

    <div id="ducha-lead-success" class="ducha-lead-success" hidden>
      <h2>Presupuesto enviado</h2>
      <p>Hemos registrado tu solicitud correctamente.</p>
      <p>Te hemos enviado el enlace a tu correo electrónico.</p>
    </div>
  </section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.home-header {
  position: relative;
  background: #fff;
  padding: 12px 0;
  box-shadow: 0 8px 24px rgba(18, 48, 71, .08);
}

.home-header .header-inner {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-header div.site-logo {
  display: flex;
  align-items: center;
  width: auto;
  height: auto;
  margin: 0;
  line-height: 0;
}

.home-header img.site-logo {
  display: block;
  width: auto;
  height: 64px;
  max-width: 220px;
  object-fit: contain;
  filter: none;
  margin: 0;
}

.ducha-flow {
  min-height: calc(100vh - 96px);
  background: #f4f7fb;
  padding: 42px 16px;
}

.ducha-flow__panel {
  width: min(920px, 100%);
  margin: 0 auto;
  background: #fff;
  border: 1px solid #dbe4ee;
  border-radius: 8px;
  box-shadow: 0 18px 55px rgba(20, 32, 48, .08);
  overflow: hidden;
}

.ducha-flow__header {
  padding: 28px;
  background: #123047;
  color: #fff;
}

.ducha-flow__header p {
  margin: 0 0 8px;
  color: #b9d7e8;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
}

.ducha-flow__header h1 {
  margin: 0;
  font-size: 28px;
  line-height: 1.2;
}

.ducha-chat {
  min-height: 260px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.ducha-bubble {
  max-width: 78%;
  padding: 13px 15px;
  border-radius: 8px;
  line-height: 1.45;
}

.ducha-bubble--bot {
  align-self: flex-start;
  background: #eef5f8;
  color: #163248;
}

.ducha-bubble--user {
  align-self: flex-end;
  background: #166b8f;
  color: #fff;
}

.ducha-options {
  padding: 0 24px 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.ducha-options button,
.ducha-form button {
  border: 0;
  background: #166b8f;
  color: #fff;
  border-radius: 6px;
  padding: 11px 16px;
  font-weight: 700;
  cursor: pointer;
}

.ducha-options button {
  background: #e8f2f6;
  color: #123047;
  border: 1px solid #c8dce7;
}

.ducha-form {
  border-top: 1px solid #e5edf3;
  padding: 18px 24px 24px;
  display: flex;
  gap: 12px;
}

.ducha-form input {
  flex: 1;
  min-width: 0;
  border: 1px solid #cbd7e2;
  border-radius: 6px;
  padding: 12px 14px;
  font-size: 16px;
}

.ducha-lead-form,
.ducha-lead-success {
  border-top: 1px solid #e5edf3;
  padding: 24px;
}

.ducha-lead-form h2,
.ducha-lead-success h2 {
  margin: 0 0 14px;
  color: #123047;
  font-size: 24px;
  line-height: 1.25;
}

.ducha-lead-form p,
.ducha-lead-success p {
  margin: 0 0 13px;
  color: #344b5d;
  line-height: 1.55;
}

.ducha-lead-form label:not(.ducha-privacy) {
  display: block;
  margin: 18px 0 7px;
  color: #123047;
  font-weight: 700;
}

.ducha-lead-form input[type="email"] {
  width: 100%;
  border: 1px solid #cbd7e2;
  border-radius: 6px;
  padding: 12px 14px;
  font-size: 16px;
}

.ducha-privacy {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 16px 0;
  color: #263f52;
  line-height: 1.45;
}

.ducha-privacy input {
  margin-top: 4px;
}

.ducha-privacy a {
  color: #166b8f;
  font-weight: 700;
}

.ducha-lead-form button {
  border: 0;
  background: #166b8f;
  color: #fff;
  border-radius: 6px;
  padding: 12px 18px;
  font-weight: 700;
  cursor: pointer;
}

.ducha-lead-form button:disabled {
  cursor: wait;
  opacity: .72;
}

.ducha-lead-error {
  margin: 0 0 14px;
  color: #9d1d1d;
  font-weight: 700;
}

@media (max-width: 640px) {
  .home-header {
    padding: 10px 0;
  }

  .home-header img.site-logo {
    height: 56px;
    max-width: 190px;
  }

  .ducha-flow {
    padding: 18px 10px;
  }

  .ducha-flow__header,
  .ducha-chat,
  .ducha-lead-form,
  .ducha-lead-success {
    padding-left: 16px;
    padding-right: 16px;
  }

  .ducha-bubble {
    max-width: 100%;
  }

  .ducha-form {
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: column;
  }
}
</style>
<script>
(() => {
  const API_BASE = '{{ api_base }}';
  const INTRO_MESSAGE = '{{ intro_message }}';
  let estado = null;
  let snapshotId = null;
  let leadSubmitting = false;
  const chat = document.getElementById('ducha-chat');
  const form = document.getElementById('ducha-form');
  const input = document.getElementById('ducha-input');
  const options = document.getElementById('ducha-options');
  const leadForm = document.getElementById('ducha-lead-form');
  const leadEmail = document.getElementById('ducha-lead-email');
  const leadPrivacy = document.getElementById('ducha-lead-privacy');
  const leadError = document.getElementById('ducha-lead-error');
  const leadSuccess = document.getElementById('ducha-lead-success');

  function bubble(text, type) {
    const div = document.createElement('div');
    div.className = `ducha-bubble ducha-bubble--${type}`;
    div.textContent = text;
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function setBusy(busy) {
    input.disabled = busy;
    form.querySelector('button').disabled = busy;
  }

  function renderOptions(items) {
    options.innerHTML = '';
    if (!items || items.length === 0) {
      options.hidden = true;
      return;
    }

    items.forEach(item => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = item.etiqueta;
      button.addEventListener('click', () => sendSelection(item));
      options.appendChild(button);
    });
    options.hidden = false;
  }

  function renderResponse(data) {
    if (!data.ok) {
      bubble(data.error || 'No hemos podido continuar ahora mismo.', 'bot');
      setBusy(false);
      return;
    }

    estado = data.estado || estado;

    if (data.incompleto) {
      bubble(data.pregunta || 'Necesitamos confirmar algunos datos antes de calcular el presupuesto.', 'bot');
      form.hidden = true;
      options.hidden = true;
      setBusy(false);
      return;
    }

    if (data.finalizada) {
      snapshotId = data.snapshotId || null;
      form.hidden = true;
      options.hidden = true;
      leadForm.hidden = false;
      leadEmail.focus();
      return;
    }

    bubble(data.pregunta, 'bot');
    renderOptions(data.opciones || []);
    setBusy(false);
    input.focus();
  }

  async function post(url, payload) {
    setBusy(true);
    const requestPayload = payload || {};
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestPayload),
    });
    const data = await parseJsonResponse(response);
    return data;
  }

  async function postLead(payload) {
    const url = `${API_BASE}/lead`;
    const requestPayload = payload || {};
    const response = await fetch(`${API_BASE}/lead`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestPayload),
    });
    const data = await parseJsonResponse(response);
    if (!response.ok || !data.ok) {
      throw new Error(data.error || 'No hemos podido registrar tu solicitud.');
    }
    return data;
  }

  async function parseJsonResponse(response) {
    const contentType = response.headers.get('content-type') || '';

    if (contentType.includes('application/json')) {
      return response.json();
    }

    await response.text();

    if (!response.ok) {
      throw new Error('No hemos podido registrar tu solicitud ahora mismo.');
    }

    throw new Error('Respuesta inesperada del servidor.');
  }

  async function sendText(text) {
    bubble(text, 'user');
    input.value = '';
    const data = await post(`${API_BASE}/answer`, { estado, respuesta: text });
    renderResponse(data);
  }

  async function sendSelection(item) {
    bubble(item.etiqueta, 'user');
    const seleccion = {};
    seleccion[item.campo] = item.valor;
    const data = await post(`${API_BASE}/answer`, { estado, seleccion });
    renderResponse(data);
  }

  form.addEventListener('submit', event => {
    event.preventDefault();
    const value = input.value.trim();
    if (!value) return;
    sendText(value).catch(() => {
      bubble('Ha ocurrido un error de conexión. Inténtalo de nuevo.', 'bot');
      setBusy(false);
    });
  });

  leadForm.addEventListener('submit', event => {
    event.preventDefault();

    if (leadSubmitting) return;

    leadError.hidden = true;
    leadError.textContent = '';

    if (!leadEmail.value.trim() || !leadEmail.checkValidity()) {
      leadError.textContent = 'Introduce una dirección de correo electrónico válida.';
      leadError.hidden = false;
      return;
    }

    if (!leadPrivacy.checked) {
      leadError.textContent = 'Debes confirmar que has leído la información sobre protección de datos.';
      leadError.hidden = false;
      return;
    }

    leadSubmitting = true;
    leadForm.querySelector('button').disabled = true;
    leadForm.querySelector('button').textContent = 'Preparando...';

    postLead({
      email: leadEmail.value.trim(),
      privacidad: leadPrivacy.checked,
      snapshotId,
    }).then(() => {
      leadForm.hidden = true;
      leadSuccess.hidden = false;
      bubble('Te hemos enviado el presupuesto por email.', 'bot');
    }).catch(error => {
      leadError.textContent = error.message || 'No hemos podido registrar tu solicitud.';
      leadError.hidden = false;
      leadSubmitting = false;
      leadForm.querySelector('button').disabled = false;
      leadForm.querySelector('button').textContent = 'Enviarme mi presupuesto';
    });
  });

  bubble(INTRO_MESSAGE, 'bot');
  post(`${API_BASE}/start`)
    .then(renderResponse)
    .catch(() => {
      bubble('No podemos iniciar el presupuestador ahora mismo.', 'bot');
      setBusy(false);
    });
})();
</script>
{% endblock %}
