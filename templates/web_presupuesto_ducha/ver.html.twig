<script>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.querySelector('[data-presupuesto-actions]');

  if (!root) {
    return;
  }

  const endpoint = root.dataset.endpoint;
  const comunicacionToken = root.dataset.comunicacionToken || '';
  const panel = root.querySelector('[data-actions-panel]');
  const message = root.querySelector('[data-actions-message]');
  const menu = root.querySelector('[data-actions-menu]');
  const flows = Array.from(root.querySelectorAll('[data-flow]'));

  function hideFlows() {
    flows.forEach(function (flow) {
      flow.hidden = true;
    });
  }

  function showFlow(name) {
    hideFlows();
    if (menu) {
      menu.hidden = false;
    }
    if (message) {
      message.hidden = true;
      message.textContent = '';
    }

    const flow = root.querySelector('[data-flow="' + name + '"]');
    if (flow) {
      flow.hidden = false;
      flow.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function showMessage(text) {
    hideFlows();
    if (menu) {
      menu.hidden = true;
    }
    if (message) {
      message.textContent = text;
      message.hidden = false;
      message.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function payload(tipo, datos) {
    return {
      tipo: tipo,
      datos: datos || {},
      comunicacionToken: comunicacionToken
    };
  }

  function send(tipo, datos, confirmation) {
    return fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload(tipo, datos))
    }).then(function (response) {
      return response.json().then(function (data) {
        if (!response.ok || data.ok !== true) {
          throw new Error(data.error || 'No hemos podido registrar la acción.');
        }

        showMessage(confirmation);
      });
    }).catch(function (error) {
      showMessage(error.message || 'No hemos podido registrar la acción.');
    });
  }

  root.querySelector('[data-action-open]')?.addEventListener('click', function () {
    panel.hidden = false;
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  root.addEventListener('click', function (event) {
    const target = event.target;

    if (!(target instanceof HTMLElement)) {
      return;
    }

    const choice = target.dataset.actionChoice;

    if (choice === 'duda' || choice === 'cambio' || choice === 'contacto' || choice === 'medicion' || choice === 'no_continua') {
      showFlow(choice);
      return;
    }

    if (target.dataset.showCustomDuda !== undefined) {
      const form = root.querySelector('[data-form="duda"]');
      if (form) {
        form.hidden = false;
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      return;
    }

    if (target.dataset.dudaFrecuente) {
      send('duda', { mensaje: target.dataset.dudaFrecuente }, 'Gracias.\nRevisamos tu duda y te responderemos sobre este presupuesto.');
      return;
    }

    if (target.dataset.cambioComponente) {
      send('cambio', { componente: target.dataset.cambioComponente }, 'Perfecto.\nDejamos anotado qué quieres revisar en este presupuesto.');
      return;
    }

    if (target.dataset.confirmNoContinua !== undefined) {
      send('no_continua', {}, 'Seguimiento cerrado.\nNo volveremos a escribirte sobre este presupuesto.');
      return;
    }

    if (target.dataset.actionBack !== undefined) {
      hideFlows();
      if (menu) {
        menu.hidden = false;
      }
      if (message) {
        message.hidden = true;
        message.textContent = '';
      }
    }
  });

  root.querySelector('[data-form="duda"]')?.addEventListener('submit', function (event) {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);

    send('duda', { mensaje: String(data.get('mensaje') || '') }, 'Gracias.\nRevisamos tu duda y te responderemos sobre este presupuesto.');
  });

  root.querySelector('[data-form="contacto"]')?.addEventListener('submit', function (event) {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);

    send('solicita_contacto', {
      telefono: String(data.get('telefono') || ''),
      franja: String(data.get('franja') || ''),
      mensaje: String(data.get('mensaje') || '')
    }, 'Perfecto.\nYa tenemos lo necesario para hablar contigo.');
  });

  root.querySelector('[data-form="medicion"]')?.addEventListener('submit', function (event) {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);

    send('solicita_medicion', {
      telefono: String(data.get('telefono') || ''),
      direccion: String(data.get('direccion') || ''),
      franja: String(data.get('franja') || ''),
      observaciones: String(data.get('observaciones') || '')
    }, 'Perfecto.\nYa tenemos los datos necesarios para preparar el siguiente paso contigo.');
  });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const viewNonce = '{{ viewNonce|e('js') }}';
  const endpoint = '{{ visualizacionEndpoint|e('js') }}';
  const storageKey = 'presupuesto-web-view-' + viewNonce;
  let scheduled = false;
  let sent = false;

  function alreadySentInTab() {
    try {
      return window.sessionStorage && sessionStorage.getItem(storageKey) === '1';
    } catch (e) {
      return false;
    }
  }

  function markSentInTab() {
    try {
      if (window.sessionStorage) {
        sessionStorage.setItem(storageKey, '1');
      }
    } catch (e) {}
  }

  function sendView() {
    if (sent || alreadySentInTab() || document.visibilityState !== 'visible') {
      return;
    }

    sent = true;
    markSentInTab();

    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ viewNonce })
    }).catch(function () {});
  }

  function scheduleView() {
    if (scheduled || sent || alreadySentInTab() || document.visibilityState !== 'visible') {
      return;
    }

    scheduled = true;
    window.setTimeout(function () {
      scheduled = false;
      sendView();
    }, 1800);
  }

  scheduleView();
  document.addEventListener('visibilitychange', scheduleView);
});
</script>
{% endblock %}
