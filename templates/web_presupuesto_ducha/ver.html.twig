{% extends 'layouts/base_public.html.twig' %}

{% block title %}Tu presupuesto de ducha{% endblock %}

{% block body %}
{% set totalPresupuesto = presupuesto.total ?? resultado.total ?? 0 %}
{% set totalFormateado = totalPresupuesto|number_format(2, ',', '.') ~ ' €' %}
{% set textoPresupuesto = ((resultado.lineas ?? [])|json_encode ~ ' ' ~ (jsonSolicitudBudgetFlow ?? [])|json_encode)|lower %}
{% set tienePlato = 'plato' in textoPresupuesto %}
{% set tieneMampara = 'mampara' in textoPresupuesto %}
{% set tieneGriferia = 'grifer' in textoPresupuesto %}
<div class="presupuesto-page">
  <section class="presupuesto-hero" aria-labelledby="presupuesto-title">
    <p class="presupuesto-hero__brand">Pavimentos Gijón</p>

    <div class="presupuesto-hero__content">
      <h1 id="presupuesto-title">Hemos hecho números con tu baño.</h1>

      <p class="presupuesto-hero__intro">Pero antes de enseñarte la cifra, hay algo que queremos que tengas claro.</p>

      <div class="presupuesto-hero__statement">
        <p>No hemos calculado cuánto cuesta un plato, una mampara y un grifo.</p>
        <p>Hemos calculado cuánto creemos que cuesta resolver el cambio completo.</p>
        <p>Y hay bastante diferencia.</p>
      </div>

      <a class="presupuesto-hero__cta" href="#detalle-presupuesto">Te contamos por qué ↓</a>
    </div>
  </section>

  <section id="detalle-presupuesto" class="presupuesto-story" aria-label="Qué hay detrás de esta cifra">
    <div class="presupuesto-story__inner">
      <p class="presupuesto-story__lead">Ahora tienes una bañera.</p>

      <p>Cuando terminemos, tendrás una nueva zona de ducha lista para utilizar.</p>

      <p class="presupuesto-story__beat">Dicho así parece sencillo.</p>
      <p class="presupuesto-story__beat presupuesto-story__beat--quiet">Entre una cosa y otra pasan bastantes cosas.</p>

      <div class="presupuesto-story__section">
        <p>Hay que entrar en tu casa.</p>

        <p>Retirar lo que tienes ahora sin convertir el resto de la vivienda en una obra.</p>

        <p>Proteger las zonas por las que vamos a pasar.</p>

        <p>Y también las zonas comunes.</p>

        <p class="presupuesto-story__neighbor">Porque tus vecinos no han pedido una reforma.</p>

        <p>Hay que coordinar a las personas que tienen que intervenir, resolver las adaptaciones que aparezcan y conseguir que todo funcione como debe.</p>
      </div>

      <div class="presupuesto-story__focus">
        <p>Y, sobre todo, conseguir una cosa:</p>
        <p>Que tú no tengas que convertirte en jefe de obra durante unos días.</p>
      </div>

      <p>No deberías tener que averiguar quién viene después.</p>

      <p>Ni perseguir a uno porque otro está esperando.</p>

      <p>Ni resolver tú los problemas que aparezcan durante la instalación.</p>

      <p class="presupuesto-story__beat">Para eso estamos nosotros.</p>

      <div class="presupuesto-story__price" aria-label="Tu presupuesto estimado">
        <p>Y con todo eso en mente, esta es la primera cifra que nos sale para tu baño:</p>

        <strong>{{ totalFormateado }}</strong>

        <small>IVA incluido</small>

        <p>No es un precio &laquo;desde&raquo;.</p>

        <p>Es la estimación que hemos calculado con la información que nos has dado.</p>
      </div>
    </div>
  </section>

  <section class="presupuesto-actions" aria-labelledby="presupuesto-actions-title">
    <div class="presupuesto-actions__inner" data-presupuesto-actions data-endpoint="{{ interaccionEndpoint }}" data-comunicacion-token="{{ comunicacionOrigenToken|default('') }}">
      <div class="presupuesto-actions__intro">
        <h2 id="presupuesto-actions-title">¿Quieres cambiar algo o tienes alguna duda?</h2>
        <p>Revisamos el presupuesto contigo.</p>
        <button type="button" class="presupuesto-actions__primary" data-action-open>Revisamos el presupuesto contigo</button>
      </div>

      <div class="presupuesto-actions__panel" data-actions-panel hidden>
        <p class="presupuesto-actions__question">Claro. ¿Qué necesitas?</p>

        <div class="presupuesto-actions__choices" data-actions-menu>
          <button type="button" data-action-choice="duda">Tengo una duda</button>
          <button type="button" data-action-choice="cambio">Quiero cambiar algo</button>
          <button type="button" data-action-choice="contacto">Prefiero que hablemos</button>
          <button type="button" data-action-choice="medicion">Quiero que vengáis a medir</button>
        </div>

        <button type="button" class="presupuesto-actions__secondary" data-action-choice="no_continua">No quiero continuar con este presupuesto</button>

        <div class="presupuesto-actions__flow" data-flow="duda" hidden>
          <p>¿Qué quieres saber?</p>
          <div class="presupuesto-actions__choices">
            <button type="button" data-duda-frecuente="¿Cuándo podríais hacer la obra?">¿Cuándo podríais hacer la obra?</button>
            <button type="button" data-duda-frecuente="¿Cuánto suele durar?">¿Cuánto suele durar?</button>
            <button type="button" data-duda-frecuente="¿Qué incluye esta propuesta?">¿Qué incluye esta propuesta?</button>
            <button type="button" data-action-choice="cambio">Quiero cambiar alguna cosa</button>
            <button type="button" data-show-custom-duda>Tengo otra duda</button>
          </div>
          <form class="presupuesto-actions__form" data-form="duda" hidden>
            <label>
              Cuéntanos qué quieres saber
              <textarea name="mensaje" rows="4" required></textarea>
            </label>
            <button type="submit">Enviar mi duda</button>
          </form>
        </div>

        <div class="presupuesto-actions__flow" data-flow="cambio" hidden>
          <p>¿Qué te gustaría cambiar?</p>
          <div class="presupuesto-actions__choices">
            {% if tienePlato %}
              <button type="button" data-cambio-componente="plato">Plato de ducha</button>
            {% endif %}
            {% if tieneMampara %}
              <button type="button" data-cambio-componente="mampara">Mampara</button>
            {% endif %}
            {% if tieneGriferia %}
              <button type="button" data-cambio-componente="griferia">Grifería</button>
            {% endif %}
          </div>
        </div>

        <form class="presupuesto-actions__flow presupuesto-actions__form" data-flow="contacto" data-form="contacto" hidden>
          <label>
            Teléfono
            <input type="tel" name="telefono" autocomplete="tel" required>
          </label>
          <fieldset>
            <legend>¿Cuándo te viene mejor?</legend>
            <label><input type="radio" name="franja" value="manana" required> Mañana</label>
            <label><input type="radio" name="franja" value="tarde"> Tarde</label>
            <label><input type="radio" name="franja" value="indiferente"> Me da igual</label>
          </fieldset>
          <label>
            ¿Quieres decirnos algo antes de que te llamemos?
            <textarea name="mensaje" rows="3"></textarea>
          </label>
          <button type="submit">Enviar</button>
        </form>

        <form class="presupuesto-actions__flow presupuesto-actions__form" data-flow="medicion" data-form="medicion" hidden>
          <label>
            Teléfono
            <input type="tel" name="telefono" autocomplete="tel" required>
          </label>
          <label>
            Dirección donde se realizará la obra
            <input type="text" name="direccion" autocomplete="street-address" required>
          </label>
          <fieldset>
            <legend>¿Cuándo te viene mejor?</legend>
            <label><input type="radio" name="franja" value="manana" required> Mañana</label>
            <label><input type="radio" name="franja" value="tarde"> Tarde</label>
            <label><input type="radio" name="franja" value="indiferente"> Me da igual</label>
          </fieldset>
          <label>
            ¿Hay algo que debamos saber antes de ir?
            <textarea name="observaciones" rows="3"></textarea>
          </label>
          <button type="submit">Enviar</button>
        </form>

        <div class="presupuesto-actions__flow" data-flow="no_continua" hidden>
          <p>¿Seguro que quieres cerrar el seguimiento de este presupuesto?</p>
          <div class="presupuesto-actions__choices">
            <button type="button" data-confirm-no-continua>Sí, cerrar seguimiento</button>
            <button type="button" data-action-back>Volver</button>
          </div>
        </div>

        <p class="presupuesto-actions__message" data-actions-message role="status" hidden></p>
      </div>
    </div>
  </section>
</div>
{% endblock %}

