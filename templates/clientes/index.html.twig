{% extends 'base.html.twig' %}

{% block title %}Clientes{% endblock %}
{% block cabecera %}Clientes{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Clientes</li>{% endblock %}

{% block stylesheets %}
    <style>
        .clientes-kpi { border: 0; border-radius: .85rem; box-shadow: 0 2px 10px rgba(0, 0, 0, .045); }
        .clientes-kpi-icon { align-items: center; background: #edf3ff; border-radius: .75rem; color: #2962ff; display: inline-flex; font-size: 1.25rem; height: 2.75rem; justify-content: center; width: 2.75rem; }
        .clientes-kpi-icon.is-success { background: #e7f8ef; color: #1f9d55; }
        .clientes-kpi-icon.is-warning { background: #fff5df; color: #b7791f; }
        .clientes-toolbar { border: 1px solid #e8edf3; border-radius: .85rem; }
        .clientes-search { min-width: 16rem; }
        .clientes-avatar { align-items: center; background: #eaf0ff; border-radius: 50%; color: #2454d5; display: inline-flex; flex: 0 0 auto; font-size: .8rem; font-weight: 700; height: 2.45rem; justify-content: center; width: 2.45rem; }
        .clientes-name { color: #263238; font-weight: 650; text-decoration: none; }
        .clientes-name:hover { color: #2962ff; text-decoration: underline; }
        .clientes-contact a { color: #546e7a; text-decoration: none; }
        .clientes-contact a:hover { color: #2962ff; }
        .clientes-activity { min-width: 10.5rem; }
        .clientes-empty { padding: 4rem 1.5rem; text-align: center; }
        .clientes-empty-icon { color: #aab7c4; font-size: 2.3rem; }
        @media (max-width: 767.98px) { .clientes-search { min-width: 100%; } }
    </style>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    {% endfor %}

    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h4 class="mb-1">Gestión de clientes</h4>
            <p class="text-muted mb-0">Consulta los datos de contacto y la actividad comercial de cada cliente.</p>
        </div>
        <a href="{{ path('clientes_nuevo') }}" class="btn btn-primary">
            <i class="ti-plus me-1"></i> Nuevo cliente
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card clientes-kpi h-100"><div class="card-body d-flex align-items-center gap-3">
                <span class="clientes-kpi-icon"><i class="ti-user"></i></span>
                <div><small class="text-muted d-block">Clientes registrados</small><strong class="fs-4">{{ resumen.total }}</strong></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card clientes-kpi h-100"><div class="card-body d-flex align-items-center gap-3">
                <span class="clientes-kpi-icon is-success"><i class="ti-briefcase"></i></span>
                <div><small class="text-muted d-block">Con proyectos</small><strong class="fs-4">{{ resumen.conProyectos }}</strong></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card clientes-kpi h-100"><div class="card-body d-flex align-items-center gap-3">
                <span class="clientes-kpi-icon"><i class="ti-mobile"></i></span>
                <div><small class="text-muted d-block">Con datos de contacto</small><strong class="fs-4">{{ resumen.conContacto }}</strong></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card clientes-kpi h-100"><div class="card-body d-flex align-items-center gap-3">
                <span class="clientes-kpi-icon is-warning"><i class="ti-alert"></i></span>
                <div><small class="text-muted d-block">Sin contacto</small><strong class="fs-4">{{ resumen.sinContacto }}</strong></div>
            </div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="{{ path('clientes_index') }}" class="clientes-toolbar bg-light p-3 mb-4">
                <div class="row align-items-end g-3">
                    <div class="col-lg-5">
                        <label for="clientes-busqueda" class="form-label small fw-semibold">Buscar cliente</label>
                        <div class="input-group clientes-search">
                            <span class="input-group-text bg-white"><i class="ti-search"></i></span>
                            <input id="clientes-busqueda" name="q" value="{{ filtros.busqueda }}" class="form-control" type="search" placeholder="Nombre, teléfono, email, ciudad o NIF">
                        </div>
                    </div>
                    <div class="col-sm-4 col-lg-2">
                        <label for="clientes-actividad" class="form-label small fw-semibold">Actividad</label>
                        <select id="clientes-actividad" name="actividad" class="form-select">
                            <option value="todos" {{ filtros.actividad == 'todos' ? 'selected' }}>Todos</option>
                            <option value="con_proyectos" {{ filtros.actividad == 'con_proyectos' ? 'selected' }}>Con proyectos</option>
                            <option value="sin_proyectos" {{ filtros.actividad == 'sin_proyectos' ? 'selected' }}>Sin proyectos</option>
                            <option value="sin_contacto" {{ filtros.actividad == 'sin_contacto' ? 'selected' }}>Sin contacto</option>
                        </select>
                    </div>
                    <div class="col-sm-4 col-lg-2">
                        <label for="clientes-orden" class="form-label small fw-semibold">Ordenar por</label>
                        <select id="clientes-orden" name="orden" class="form-select">
                            <option value="nombre" {{ filtros.orden == 'nombre' ? 'selected' }}>Nombre</option>
                            <option value="alta" {{ filtros.orden == 'alta' ? 'selected' }}>Fecha de alta</option>
                        </select>
                    </div>
                    <div class="col-sm-4 col-lg-1">
                        <label for="clientes-dir" class="form-label small fw-semibold">Sentido</label>
                        <select id="clientes-dir" name="dir" class="form-select" aria-label="Sentido de ordenación">
                            <option value="asc" {{ filtros.direccion|lower == 'asc' ? 'selected' }}>↑</option>
                            <option value="desc" {{ filtros.direccion|lower == 'desc' ? 'selected' }}>↓</option>
                        </select>
                    </div>
                    <div class="col-lg-2 d-flex gap-2">
                        <button class="btn btn-primary flex-grow-1" type="submit">Aplicar</button>
                        {% if filtros.busqueda or filtros.actividad != 'todos' or filtros.orden != 'nombre' or filtros.direccion|lower != 'asc' %}
                            <a href="{{ path('clientes_index') }}" class="btn btn-outline-secondary" title="Limpiar filtros" aria-label="Limpiar filtros"><i class="ti-close"></i></a>
                        {% endif %}
                    </div>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3 gap-3">
                <p class="mb-0 text-muted small">
                    {% if pagination.total == 1 %}1 cliente encontrado{% else %}{{ pagination.total }} clientes encontrados{% endif %}
                    {% if pagination.pages > 1 %} · Página {{ pagination.page }} de {{ pagination.pages }}{% endif %}
                </p>
                <span class="small text-muted d-none d-md-inline">Los presupuestos incluyen históricos y documentos actuales.</span>
            </div>

            {% if clientes|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Cliente</th>
                                <th scope="col">Contacto</th>
                                <th scope="col">Ubicación</th>
                                <th scope="col">Actividad</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for cliente in clientes %}
                                {% set actividad = resumenesActividad[cliente.id]|default({proyectos: 0, documentos: 0, presupuestos: 0}) %}
                                {% set nombreCompleto = (cliente.nombreCl ~ ' ' ~ (cliente.apellidosCl ?? ''))|trim %}
                                {% set iniciales = ((cliente.nombreCl|default(''))|slice(0, 1) ~ (cliente.apellidosCl|default(''))|slice(0, 1))|upper %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="clientes-avatar">{{ iniciales ?: '?' }}</span>
                                            <div>
                                                <a class="clientes-name" href="{{ path('clientes_show', {id: cliente.id}) }}">{{ nombreCompleto ?: 'Cliente sin nombre' }}</a>
                                                <div class="small text-muted">Alta {{ cliente.timestampaltaCl ? cliente.timestampaltaCl|date('d/m/Y') : 'sin fecha' }}{% if cliente.dni %} · {{ cliente.dni }}{% endif %}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="clientes-contact">
                                        {% if cliente.telefono1Cl %}<div><a href="tel:{{ cliente.telefono1Cl|replace({' ': ''}) }}"><i class="ti-mobile me-1"></i>{{ cliente.telefono1Cl }}</a></div>{% endif %}
                                        {% if cliente.telefono2Cl %}<div><a href="tel:{{ cliente.telefono2Cl|replace({' ': ''}) }}"><i class="ti-mobile me-1"></i>{{ cliente.telefono2Cl }}</a></div>{% endif %}
                                        {% if cliente.emailCl %}<div class="text-truncate" style="max-width: 15rem;"><a href="mailto:{{ cliente.emailCl }}"><i class="ti-email me-1"></i>{{ cliente.emailCl }}</a></div>{% endif %}
                                        {% if not cliente.telefono1Cl and not cliente.telefono2Cl and not cliente.emailCl %}<span class="text-muted small">Sin datos de contacto</span>{% endif %}
                                    </td>
                                    <td>
                                        {% if cliente.ciudadCl %}<div>{{ cliente.ciudadCl }}</div>{% endif %}
                                        {% if cliente.direccionCl %}<div class="small text-muted text-truncate" style="max-width: 16rem;">{{ cliente.direccionCl }}</div>{% endif %}
                                        {% if not cliente.ciudadCl and not cliente.direccionCl %}<span class="text-muted small">Sin dirección</span>{% endif %}
                                    </td>
                                    <td class="clientes-activity">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">{{ actividad.proyectos }} {{ actividad.proyectos == 1 ? 'proyecto' : 'proyectos' }}</span>
                                        <span class="badge bg-light text-dark border mt-1">{{ actividad.presupuestos }} {{ actividad.presupuestos == 1 ? 'presupuesto' : 'presupuestos' }}</span>
                                        {% if actividad.documentos > 0 %}<div class="small text-muted mt-1">{{ actividad.documentos }} {{ actividad.documentos == 1 ? 'documento' : 'documentos' }}</div>{% endif %}
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('clientes_show', {id: cliente.id}) }}">Ver ficha</a>
                                        <a class="btn btn-sm btn-primary" href="{{ path('clientes_edit', {id: cliente.id}) }}" aria-label="Editar {{ nombreCompleto }}"><i class="ti-pencil"></i></a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if pagination.pages > 1 %}
                    {% set paginaAnterior = pagination.page - 1 %}
                    {% set paginaSiguiente = pagination.page + 1 %}
                    {% set parametros = {q: filtros.busqueda, actividad: filtros.actividad, orden: filtros.orden, dir: filtros.direccion} %}
                    <nav class="d-flex flex-wrap justify-content-between align-items-center mt-4 gap-2" aria-label="Paginación de clientes">
                        <a class="btn btn-outline-secondary btn-sm {{ pagination.page == 1 ? 'disabled' }}" href="{{ pagination.page > 1 ? path('clientes_index', parametros|merge({page: paginaAnterior})) : '#' }}">← Anterior</a>
                        <span class="small text-muted">Mostrando {{ ((pagination.page - 1) * pagination.perPage) + 1 }}–{{ min(pagination.page * pagination.perPage, pagination.total) }} de {{ pagination.total }}</span>
                        <a class="btn btn-outline-secondary btn-sm {{ pagination.page == pagination.pages ? 'disabled' }}" href="{{ pagination.page < pagination.pages ? path('clientes_index', parametros|merge({page: paginaSiguiente})) : '#' }}">Siguiente →</a>
                    </nav>
                {% endif %}
            {% else %}
                <div class="clientes-empty">
                    <div class="clientes-empty-icon mb-3"><i class="ti-search"></i></div>
                    <h5>No hay clientes que coincidan</h5>
                    <p class="text-muted mb-3">Prueba a modificar los filtros o crea una nueva ficha.</p>
                    {% if filtros.busqueda or filtros.actividad != 'todos' %}<a href="{{ path('clientes_index') }}" class="btn btn-outline-secondary">Limpiar filtros</a>{% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
