{% extends 'base.html.twig' %}
{% form_theme form 'fields.html.twig' %}

{% block title %}Editar cliente{% endblock %}
{% block cabecera %}Editar cliente{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('clientes_index') }}">Clientes</a></li>
    <li class="breadcrumb-item"><a href="{{ path('clientes_show', {id: cliente.id}) }}">Ficha</a></li>
    <li class="breadcrumb-item active">Editar</li>
{% endblock %}

{% block stylesheets %}
    <style>
        .cliente-edit-intro { border-left: 4px solid #2962ff; }
        .cliente-edit-section-title { font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
        .cliente-edit-card { border: 0; box-shadow: 0 2px 10px rgba(0,0,0,.045); }
    </style>
{% endblock %}

{% block body %}
    {% set nombreCompleto = (cliente.nombreCl ~ ' ' ~ (cliente.apellidosCl ?? ''))|trim %}
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="cliente-edit-intro bg-white rounded p-3 mb-4 shadow-sm">
                <h4 class="mb-1">Actualizar ficha de cliente</h4>
                <p class="mb-0 text-muted">Editando los datos de {{ nombreCompleto ?: 'este cliente' }}. La información comercial no se modifica desde aquí.</p>
            </div>

            {{ form_start(form) }}
                <div class="card cliente-edit-card mb-4">
                    <div class="card-body p-4">
                        <div class="cliente-edit-section-title text-primary mb-3">Identificación</div>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.nombreCl) }}</div>
                            <div class="col-md-6">{{ form_row(form.apellidosCl) }}</div>
                            <div class="col-md-4">{{ form_row(form.dni) }}</div>
                        </div>
                    </div>
                </div>

                <div class="card cliente-edit-card mb-4">
                    <div class="card-body p-4">
                        <div class="cliente-edit-section-title text-primary mb-3">Contacto</div>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.telefono1Cl) }}</div>
                            <div class="col-md-6">{{ form_row(form.telefono2Cl) }}</div>
                            <div class="col-12">{{ form_row(form.emailCl) }}</div>
                        </div>
                    </div>
                </div>

                <div class="card cliente-edit-card mb-4">
                    <div class="card-body p-4">
                        <div class="cliente-edit-section-title text-primary mb-3">Dirección</div>
                        <div class="row g-3">
                            <div class="col-md-4">{{ form_row(form.ciudadCl) }}</div>
                            <div class="col-md-8">{{ form_row(form.direccionCl) }}</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
                    <a class="btn btn-outline-secondary" href="{{ path('clientes_show', {id: cliente.id}) }}">Cancelar</a>
                    <button class="btn btn-primary px-4"><i class="ti-save me-1"></i> Guardar cambios</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
