{% extends 'base.html.twig' %}

{% block title %}Seguimiento comercial de presupuestos{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Seguimiento comercial de presupuestos</h1>
            <p class="text-muted mb-0">
                Presupuestos pendientes de aceptación: registra el contacto con el cliente y su resultado.
            </p>
        </div>

        <a href="{{ path('app_proyecto_new') }}" class="btn btn-primary">
            Nuevo proyecto / presupuesto
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="row g-3 mb-4">

        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Borradores</div>
                    <div class="fs-3 fw-bold">{{ resumen.borrador }}</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Entregados</div>
                    <div class="fs-3 fw-bold text-info">{{ resumen.entregado }}</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Importe vivo</div>
                    <div class="fs-5 fw-bold">
                        {{ resumen.totalImporte|number_format(2, ',', '.') }} €
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <div>
                <h2 class="h5 mb-0">Presupuestos pendientes</h2>
                <div class="small text-muted">
                    Últimos 100 presupuestos en borrador o entregados
                </div>
            </div>

            <div class="d-flex gap-2">

                <a href="{{ path('admin_comercial_presupuestos_rechazados') }}"
                class="btn btn-sm btn-outline-danger">

                    Rechazados


                </a>

            </div>

        </div>

        <div class="card-body">

            {% if presupuestos is empty %}
                <div class="alert alert-light border mb-0">
                    No hay presupuestos pendientes de aceptación.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Presupuesto</th>
                                <th>Proyecto / cliente</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Seguimiento comercial</th>
                                <th class="text-end">Importe</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for presupuesto in presupuestos %}

                                {% set estado = presupuesto.estadoComercial|default('borrador') %}

                                {% set estadoTexto = 'Borrador' %}
                                {% set estadoClase = 'bg-warning text-dark' %}

                                {% if estado == 'entregado' %}
                                    {% set estadoTexto = 'Entregado' %}
                                    {% set estadoClase = 'bg-info' %}
                                {% endif %}

                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            {% if presupuesto.numero %}
                                                {{ presupuesto.serie }}-{{ '%04d'|format(presupuesto.numero) }}
                                            {% else %}
                                                BORRADOR
                                            {% endif %}
                                        </div>
                                        <div class="small text-muted">
                                            ID {{ presupuesto.id }}
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            {% if presupuesto.proyecto %}
                                                {{ presupuesto.proyecto.nombre }}
                                            {% else %}
                                                Sin proyecto
                                            {% endif %}
                                        </div>

                                        <div class="small text-muted">
                                            {% if presupuesto.cliente %}
                                                {{ presupuesto.cliente.nombreCl }} {{ presupuesto.cliente.apellidosCl }}
                                            {% elseif presupuesto.proyecto and presupuesto.proyecto.cliente %}
                                                {{ presupuesto.proyecto.cliente.nombreCl }} {{ presupuesto.proyecto.cliente.apellidosCl }}
                                            {% else %}
                                                Sin cliente
                                            {% endif %}
                                        </div>
                                        {% include 'comercial/_telefono_contacto.html.twig' with {presupuesto: presupuesto} only %}
                                    </td>

                                    <td>
                                        <span class="badge {{ estadoClase }}">
                                            {{ estadoTexto }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if presupuesto.fechaEmision is defined and presupuesto.fechaEmision %}
                                            {{ presupuesto.fechaEmision|date('d/m/Y') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="small text-muted">{{ presupuesto.fechaUltimoSeguimiento ? presupuesto.fechaUltimoSeguimiento|date('d/m/Y H:i') : 'Sin seguimiento' }}</div>
                                        {% if presupuesto.notaComercial %}
                                            <details><summary>Ver notas</summary><div class="small" style="white-space: pre-line">{{ presupuesto.notaComercial }}</div></details>
                                        {% endif %}
                                    </td>
                                    <td class="text-end fw-semibold">
                                        {{ presupuesto.total|default(0)|number_format(2, ',', '.') }} €
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-1 flex-wrap">

                                            <a href="{{ path('app_documento_show', {id: presupuesto.id}) }}"
                                            class="btn btn-sm btn-outline-primary">
                                                Ver
                                            </a>

                                            {% if presupuesto.estadoComercial == 'borrador' %}

                                                <form method="post"
                                                    action="{{ path('admin_comercial_presupuesto_estado', {id: presupuesto.id}) }}">

                                                    <input type="hidden" name="_token" value="{{ csrf_token('comercial_presupuesto_' ~ presupuesto.id) }}">
                                                    <input type="hidden" name="estado" value="entregado">

                                                    <button class="btn btn-sm btn-outline-info">
                                                        Marcar entregado
                                                    </button>
                                                </form>

                                            {% endif %}

                                            {% if presupuesto.estadoComercial == 'entregado' %}

                                                <form method="post"
                                                    action="{{ path('app_documento_aceptar', {id: presupuesto.id}) }}">

                                                    <input type="hidden" name="volver" value="presupuestos_comercial">

                                                    <button class="btn btn-sm btn-outline-success">
                                                        Aceptar
                                                    </button>
                                                </form>

                                            {% endif %}
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="modal" data-bs-target="#modalComercial{{ presupuesto.id }}">
                                                Acción comercial
                                            </button>

                                        </div>

                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                    {% for presupuesto in presupuestos %}
                                <div class="modal fade" id="modalComercial{{ presupuesto.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form method="post" action="{{ path('admin_comercial_presupuesto_estado', {id: presupuesto.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('comercial_presupuesto_' ~ presupuesto.id) }}">

                                                <div class="modal-header">
                                                    <h5 class="modal-title">Acción comercial · Presupuesto {{ presupuesto.id }}</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <label class="form-label" for="accion{{ presupuesto.id }}">Resultado</label>
                                                    <select id="accion{{ presupuesto.id }}" name="estado" class="form-select mb-3">
                                                        <option value="seguimiento">Registrar seguimiento</option>
                                                        {% if presupuesto.estadoComercial == 'borrador' %}<option value="entregado">Marcar como entregado</option>{% endif %}
                                                        <option value="rechazado">Rechazar presupuesto</option>
                                                    </select>
                                                    <label class="form-label">Motivo (solo para rechazar)</label>
                                                    <select name="motivo_perdida" class="form-select mb-3">
                                                        <option value="precio_alto">Le parece caro</option>
                                                        <option value="sin_respuesta">No responde</option>
                                                        <option value="lo_hace_otro">Lo hace con otra empresa</option>
                                                        <option value="aplazado">Lo deja para más adelante</option>
                                                        <option value="otro">Otro motivo</option>
                                                    </select>

                                                    <label class="form-label">Nota</label>
                                                    <textarea name="nota_comercial" class="form-control" rows="3"
                                                            placeholder="Ej.: llamada al cliente; pendiente de decidir. Obligatoria para registrar seguimiento."></textarea>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                    <button class="btn btn-primary">
                                                        Guardar acción
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
{% endfor %}
            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
