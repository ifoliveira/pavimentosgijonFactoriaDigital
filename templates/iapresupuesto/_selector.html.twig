{# templates/iapresupuesto/_selector.html.twig #}

<section id="selector-reforma" class="hero-selector">
    <div class="selector-card">
        <h3 class="selector-title">
            👋 ¿Qué tipo de reforma quieres hacer?
        </h3>

        <div class="selector-buttons">
            <button class="selector-btn btn-ducha" onclick="window.location.href='{{ path('web_presupuesto_ducha') }}'">
                🛁 Cambiar bañera por plato de ducha
            </button>

            <button class="selector-btn btn-completo" onclick="iniciarChat('baño_completo')">
                🧰 Reforma completa del baño
            </button>
        </div>
    </div>
</section>
