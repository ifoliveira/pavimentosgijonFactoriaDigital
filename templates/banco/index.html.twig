{% extends 'base.html.twig' %}

{% block title %}Banco · Pavimentos Gijón{% endblock %}
{% block cabecera %}Banco{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">Banco</li>{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('dist/css/banco-upload.css') }}">
{% endblock %}

{% block body %}
<div class="bank-upload">
    <section class="bank-upload-card">
        <div class="bank-upload-results-heading">
            <div>
                <h2>Movimientos bancarios <span class="bank-upload-count">{{ bancos|length }}</span></h2>
                <p>Consulta los movimientos y accede a sus datos para editarlos.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('banco_new') }}" class="btn btn-outline-secondary">Añadir movimiento</a>
                <a href="{{ path('uploadBank') }}" class="btn btn-primary"><i class="ti-upload" aria-hidden="true"></i> Importar extracto</a>
            </div>
        </div>
        <div class="table-responsive">
            <table id="bank-movements-table" class="table" style="width:100%">
                <thead><tr><th scope="col">Referencia</th><th scope="col">Categoría</th><th scope="col">Concepto</th><th scope="col">Fecha</th><th scope="col" class="text-end">Importe</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                {% for banco in bancos %}
                    <tr>
                        <td class="text-muted">#{{ banco.id }}</td>
                        <td>{{ banco.categoriaBn|default('Sin categoría') }}</td>
                        <td class="bank-upload-concept">{{ banco.conceptoBn }}</td>
                        <td class="bank-upload-nowrap" data-order="{{ banco.fechaBn ? banco.fechaBn|date('Y-m-d') : '' }}">{{ banco.fechaBn ? banco.fechaBn|date('d/m/Y') : '—' }}</td>
                        <td class="bank-upload-amount {{ banco.importeBn < 0 ? 'bank-upload-negative' : 'bank-upload-positive' }}" data-order="{{ banco.importeBn }}">{{ banco.importeBn|format_currency('EUR', locale='es') }}</td>
                        <td><div class="bank-upload-actions">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('banco_edit', {'id': banco.id}) }}" aria-label="Editar datos del movimiento {{ banco.id }}">Editar datos</a>
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('banco_transferencia', {'id': banco.id}) }}" aria-label="Transferencia del movimiento {{ banco.id }}"><i class="ti-shift-right" aria-hidden="true"></i> Transferencia</a>
                        </div></td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot><tr><th colspan="4" scope="row">Total de esta página</th><td class="bank-upload-amount"></td><td></td></tr></tfoot>
            </table>
        </div>
    </section>
</div>
{% endblock %}

{% block jscustom %}
<script>
    (function () {
        var tableElement = document.getElementById('bank-movements-table');
        var currency = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
        $(tableElement).DataTable({
            order: [[3, 'desc']],
            columnDefs: [{ targets: 5, orderable: false, searchable: false }],
            language: {
                search: 'Buscar:', lengthMenu: 'Mostrar _MENU_ movimientos',
                info: 'Mostrando _START_ a _END_ de _TOTAL_ movimientos',
                infoEmpty: 'No hay movimientos', infoFiltered: '(de _MAX_ movimientos)',
                emptyTable: 'Todavía no hay movimientos bancarios.',
                zeroRecords: 'No hay movimientos que coincidan con la búsqueda.',
                paginate: { first: 'Primera', last: 'Última', next: 'Siguiente', previous: 'Anterior' }
            },
            footerCallback: function () {
                var api = this.api();
                var total = api.column(4, { page: 'current' }).nodes().toArray().reduce(function (sum, cell) {
                    return sum + Number(cell.getAttribute('data-order'));
                }, 0);
                $(api.column(4).footer()).text(currency.format(total));
            }
        });
    })();
</script>
{% endblock %}
