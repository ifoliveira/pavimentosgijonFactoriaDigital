{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid py-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Asignar costes a obra</h1>
            <p class="text-muted mb-0">
                {{ factura.proveedorNombre }} · {{ factura.numeroFactura }}
            </p>
        </div>

        <a href="{{ path('factura_proveedor_revisar', {id: factura.id}) }}" class="btn btn-outline-secondary">
            Volver a revisar
        </a>
    </div>

    <form method="post">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">Asignada</th>
                                <th class="text-end">Disponible</th>
                                <th class="text-end">Total línea</th>
                                <th class="text-end">Cant. a asignar</th>
                                <th>Destino</th>
                                <th>Proyecto</th>
                                <th>Gasto previsto</th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for linea in factura.lineas %}
                            {% if linea.estado in ['pendiente', 'parcial'] %}

                                {% set cantidadAsignada = 0 %}
                                {% for asignacion in linea.asignaciones %}
                                    {% set cantidadAsignada = cantidadAsignada + asignacion.cantidad %}
                                {% endfor %}

                                {% set cantidadLinea = linea.cantidad|default(1) %}
                                {% set cantidadDisponible = cantidadLinea - cantidadAsignada %}

                                <tr>
                                    <td style="min-width:320px;">
                                        <div class="fw-semibold">{{ linea.descripcion }}</div>

                                        {% if linea.estado == 'parcial' %}
                                            <span class="badge bg-warning text-dark mt-1">Parcial</span>
                                        {% else %}
                                            <span class="badge bg-primary mt-1">Pendiente</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-end">
                                        {{ cantidadLinea|number_format(2, ',', '.') }}
                                    </td>

                                    <td class="text-end">
                                        {{ cantidadAsignada|number_format(2, ',', '.') }}
                                    </td>

                                    <td class="text-end fw-semibold">
                                        {{ cantidadDisponible|number_format(2, ',', '.') }}
                                    </td>

                                    <td class="text-end">
                                        {{ linea.total|default(0)|number_format(2, ',', '.') }} €
                                    </td>

                                    <td style="width:130px;">
                                        <input type="number"
                                               step="0.01"
                                               min="0"
                                               max="{{ cantidadDisponible }}"
                                               name="lineas[{{ linea.id }}][cantidad_asignada]"
                                               value="{{ cantidadDisponible }}"
                                               class="form-control form-control-sm text-end">
                                    </td>

                                    <td style="width:170px;">
                                        <select name="lineas[{{ linea.id }}][tipo_destino]"
                                                class="form-select form-select-sm tipo-destino-select">
                                            <option value="">Seleccionar</option>
                                            <option value="obra">Obra</option>
                                            <option value="general">Gasto general</option>
                                            <option value="stock">Stock / tienda</option>
                                            <option value="ignorar">Ignorar</option>
                                        </select>
                                    </td>

                                    <td style="min-width:260px;">
                                        <select name="lineas[{{ linea.id }}][proyecto_id]"
                                                class="form-select form-select-sm proyecto-select"
                                                data-linea-id="{{ linea.id }}">
                                            <option value="">Sin proyecto</option>

                                            {% for proyecto in proyectos %}
                                                <option value="{{ proyecto.id }}">
                                                    {{ proyecto.nombre }}
                                                    {% if proyecto.cliente %}
                                                        - {{ proyecto.cliente.nombreCl }}
                                                        {{ proyecto.cliente.apellidosCl }}
                                                    {% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </td>

                                    <td style="min-width:300px;">
                                        <select name="lineas[{{ linea.id }}][gasto_existente_id]"
                                                class="form-select form-select-sm gasto-existente-select"
                                                disabled>

                                            <option value="">
                                                Crear gasto nuevo
                                            </option>

                                        </select>

                                        <div class="form-text gasto-existente-ayuda">
                                            Selecciona primero una obra
                                        </div>
                                    </td>                                    
                                </tr>

                                {% if linea.asignaciones|length > 0 %}
                                    <tr class="table-light">
                                        <td colspan="9" class="small text-muted">
                                            <strong>Asignaciones ya realizadas:</strong>
                                            {% for asignacion in linea.asignaciones %}
                                                <span class="badge bg-secondary me-1">
                                                    {{ asignacion.cantidad|number_format(2, ',', '.') }}
                                                    uds ·
                                                    {{ asignacion.importe|number_format(2, ',', '.') }} €
                                                    · {{ asignacion.tipoDestino }}
                                                    {% if asignacion.proyecto %}
                                                        · {{ asignacion.proyecto.nombre }}
                                                    {% endif %}
                                                </span>
                                            {% endfor %}
                                        </td>
                                    </tr>
                                {% endif %}

                            {% endif %}
                        {% else %}
                            <tr>
                                <td colspan="9" class="p-4 text-muted">
                                    No hay líneas pendientes de asignar.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-end">
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('¿Guardar asignaciones y generar gastos de proyecto?');">
                    Guardar asignación y generar gastos
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block jscustom %}

<script>
document.addEventListener('DOMContentLoaded', function () {

    const selectsProyecto =
        document.querySelectorAll('.proyecto-select');

    selectsProyecto.forEach(function (selectProyecto) {

        selectProyecto.addEventListener('change', async function () {

            const fila = this.closest('tr');

            if (!fila) {
                return;
            }


            const selectDestino =
                fila.querySelector('.tipo-destino-select');

            const selectGasto =
                fila.querySelector('.gasto-existente-select');

            const ayuda =
                fila.querySelector('.gasto-existente-ayuda');

            const proyectoId = this.value;

            /*
            * Si seleccionamos un proyecto,
            * el destino necesariamente es OBRA.
            */
            if (proyectoId) {
                selectDestino.value = 'obra';
            }


            /*
             * Reiniciar selector.
             */
            selectGasto.innerHTML = `
                <option value="">
                    Crear gasto nuevo
                </option>
            `;

            if (!proyectoId) {

                selectGasto.disabled = true;

                ayuda.textContent =
                    'Selecciona primero una obra';

                return;
            }

            selectGasto.disabled = true;

            ayuda.textContent =
                'Buscando gastos previstos...';

            try {

                const url =
                    `/admin/proyecto/${proyectoId}/gastos-previstos`;

                const response = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(
                        data.message ||
                        'No se pudieron cargar los gastos previstos.'
                    );
                }

                const gastos = data.gastos || [];

                /*
                 * Siempre permitimos crear uno nuevo.
                 */
                selectGasto.innerHTML = `
                    <option value="">
                        Crear gasto nuevo
                    </option>
                `;

                gastos.forEach(function (gasto) {

                    const option =
                        document.createElement('option');

                    option.value = gasto.id;

                    let texto =
                        gasto.concepto
                        + ' · '
                        + formatearImporte(gasto.importe);

                    if (gasto.fecha) {
                        texto +=
                            ' · '
                            + formatearFecha(gasto.fecha);
                    }

                    if (gasto.proveedor) {
                        texto +=
                            ' · '
                            + gasto.proveedor;
                    }

                    option.textContent = texto;

                    selectGasto.appendChild(option);
                });

                selectGasto.disabled = false;

                if (gastos.length === 0) {

                    ayuda.textContent =
                        'Este proyecto no tiene gastos previstos. Se creará uno nuevo.';

                } else {

                    ayuda.textContent =
                        gastos.length
                        + ' gasto(s) previsto(s) disponible(s)';
                }

            } catch (error) {

                console.error(
                    'Error cargando gastos previstos:',
                    error
                );

                selectGasto.disabled = false;

                ayuda.textContent =
                    'No se pudieron cargar los gastos previstos.';
            }
        });
    });


    function formatearImporte(valor) {

        return Number(valor).toLocaleString(
            'es-ES',
            {
                style: 'currency',
                currency: 'EUR'
            }
        );
    }


    function formatearFecha(fecha) {

        const partes = fecha.split('-');

        if (partes.length !== 3) {
            return fecha;
        }

        return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

});
</script>

{% endblock %}