{% extends 'base.html.twig' %}

{% block title %}Proyectos pendientes{% endblock %}
{% block cabecera %}Proyectos pendientes{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Proyectos pendientes</li>
{% endblock %}

{% block body %}

    <p class="text-muted">{{ proyectosDashboard|length }} proyectos · Los presupuestos pendientes de aceptar se gestionan desde su propia bandeja.</p>
    <div class="row">

        {% for item in proyectosDashboard %}

            {% set proyecto = item.proyecto %}

            <div class="col-md-6 col-xl-4 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge {{ item.obraFinalizada ? 'bg-success' : 'bg-warning text-dark' }}">
                                {{ item.obraFinalizada ? 'Obra finalizada' : 'Obra no finalizada' }}
                            </span>
                            <small class="text-muted">#{{ proyecto.id }}</small>
                        </div>
                        <h4 class="card-title mb-1">{{ item.clienteNombre }}</h4>
                        <div class="fw-semibold mb-1">{{ proyecto.nombre ?: 'Proyecto sin nombre' }}</div>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            {% if item.estadoCobro == 'cobrado' %}
                                <span class="badge bg-success">Cobrada</span>
                            {% elseif item.estadoCobro == 'parcial' %}
                                <span class="badge bg-warning text-dark">Cobro parcial</span>
                            {% elseif item.estadoCobro == 'pendiente' %}
                                <span class="badge bg-danger">Pendiente de cobro</span>
                            {% else %}
                                <span class="badge bg-secondary">Sin importe pendiente</span>
                            {% endif %}
                            <span class="badge {{ item.facturaFinal ? 'bg-success' : 'bg-warning text-dark' }}">
                                {{ item.facturaFinal ? 'Factura final emitida' : 'Factura final pendiente' }}
                            </span>
                        </div>
                        <div class="small d-flex flex-wrap gap-2 mb-2">
                            {% if item.direccion %}<span class="text-muted"><i class="ti ti-map-pin me-1"></i>{{ item.direccion }}</span>{% endif %}
                            {% if item.clienteTelefono %}<a href="tel:{{ item.clienteTelefono|replace({' ': ''}) }}"><i class="ti ti-phone me-1"></i>{{ item.clienteTelefono }}</a>{% endif %}
                        </div>
                        <div class="row g-2 border-top border-bottom py-2 mb-2">
                            <div class="col-4"><small class="text-muted d-block">Total obra</small><strong>{{ item.total|format_currency('EUR', locale='es') }}</strong></div>
                            <div class="col-4"><small class="text-muted d-block">Cobrado</small><strong>{{ item.cobrado|format_currency('EUR', locale='es') }}</strong></div>
                            <div class="col-4"><small class="text-muted d-block">Pendiente</small><strong class="{{ item.pendiente > 0 ? 'text-danger' : 'text-success' }}">{{ item.pendiente|format_currency('EUR', locale='es') }}</strong></div>
                        </div>

                        {% include 'admin_pro/_facturas_proyecto.html.twig' with {proyecto: proyecto} only %}

                        <div class="d-flex flex-wrap gap-3 mt-2">
                            {% if item.presupuesto %}
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none btnPresupuesto"
                                        data-url="{{ path('app_proyecto_presupuesto_resumen', {id: proyecto.id}) }}">
                                    <i class="ti ti-file-text me-1"></i>Presupuesto
                                </button>
                            {% endif %}
                            {% if proyecto.cobros|length > 0 %}
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none btnJustificantes"
                                        data-url="{{ path('app_proyecto_justificantes', {id: proyecto.id}) }}">
                                    <i class="ti ti-printer me-1"></i>Justificantes
                                </button>
                            {% endif %}
                        </div>
                    </div>

                    {# =====================================================
                       ACCIONES
                       ===================================================== #}

                    <div class="card-body p-3 pt-0">

                        {% if not item.obraFinalizada and item.puedeFinalizarObra and item.facturaFinal %}
                            <form method="post" action="{{ path('app_proyecto_finalizar', {id: proyecto.id}) }}" class="mb-2"
                                  onsubmit="return confirm('¿Confirmas que has terminado esta obra? Los cobros pendientes se mantienen.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('finalizar_proyecto_' ~ proyecto.id) }}">
                                <input type="hidden" name="volver" value="panel">
                                <button type="submit" class="btn btn-sm btn-success w-100">Finalizar obra</button>
                            </form>
                        {% endif %}
                        {% if item.puedeEmitirFacturaFinal %}
                            <form method="post" action="{{ path('app_proyecto_factura_final', {id: proyecto.id}) }}" class="mb-2"
                                  onsubmit="return confirm('Se emitirá la factura final de los presupuestos aceptados, descontando los anticipos. ¿Continuar?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('factura_final_' ~ proyecto.id) }}">
                                <input type="hidden" name="volver" value="panel">
                                <button type="submit" class="btn btn-sm btn-primary w-100">Generar factura final</button>
                            </form>
                        {% elseif not item.facturaFinal %}
                            <p class="small text-muted">Para generar la factura final, primero acepta un presupuesto.</p>
                        {% endif %}

                        <div class="row g-2">

                            <div class="col-12">

                                <button
                                    type="button"
                                    class="btn btn-sm btn-light-primary w-100 btnNuevoCobro"
                                    data-url="{{ path('proyecto_cobro_nuevo', {id: proyecto.id}) }}"
                                    data-proyecto="{{ proyecto.id }}"
                                    data-cliente="{{ item.clienteNombre|e('html_attr') }}"
                                    data-pendiente="{{ item.pendiente }}"
                                    {% if item.pendiente <= 0 %}disabled{% endif %}
                                >
                                    <i class="ti ti-receipt me-1"></i>
                                    Añadir cobro
                                </button>

                            </div>




                        </div>


                        <div class="mt-2 text-center">

                            <a
                                href="{{ path(
                                    'app_proyecto_show',
                                    {
                                        id: proyecto.id
                                    }
                                ) }}"
                                class="
                                    text-muted
                                    text-decoration-none
                                    small
                                "
                            >
                                Ver proyecto
                                <i class="ti ti-chevron-right"></i>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        {% else %}

            <div class="col-12">

                <div class="card">
                    <div class="card-body text-center py-5">

                        <i
                            class="ti ti-folder-off"
                            style="font-size: 40px"
                        ></i>

                        <h4 class="mt-3">
                            No hay proyectos pendientes
                        </h4>

                        <p class="text-muted mb-0">
                            No quedan proyectos pendientes de finalizar, cobrar o emitir su factura final.
                        </p>

                    </div>
                </div>

            </div>

        {% endfor %}

    </div>

    {# =============================================================
    MODAL GASTOS PENDIENTES
    ============================================================= #}
    <div class="modal fade"
        id="modalGastosPendientes"
        tabindex="-1"
        aria-labelledby="modalGastosPendientesLabel"
        aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="modalGastosPendientesLabel">
                        Gastos del proyecto
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body" id="modalGastosPendientesBody">

                    <div class="text-muted">
                        Cargando...
                    </div>

                </div>

            </div>

        </div>

    </div>

{# =============================================================
    MODAL PRESUPUESTO
    ============================================================= #}
    <div class="modal fade"
        id="modalPresupuesto"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Presupuesto inicial
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body"
                    id="modalPresupuestoBody">

                    <div class="text-muted">
                        Cargando presupuesto...
                    </div>

                </div>

            </div>

        </div>

    </div>

    {# =============================================================
       MODALES
         Los rellenaremos posteriormente mediante AJAX
       ============================================================= #}
    <div class="modal fade"
        id="modalJustificantes"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Justificantes de cobro
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body"
                    id="modalJustificantesBody">

                    <div class="text-muted">
                        Cargando...
                    </div>

                </div>

            </div>

        </div>

    </div>

    {# =============================================================
       MODALES
       Los rellenaremos posteriormente mediante AJAX
       ============================================================= #}

    <div class="modal fade"
        id="modalProyectoGasto"
        tabindex="-1"
        aria-labelledby="modalProyectoGastoLabel"
        aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalProyectoGastoLabel">
                        Nuevo gasto del proyecto
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body" id="modalProyectoGastoBody">
                    <div class="text-muted">
                        Cargando formulario...
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div
        class="modal fade"
        id="modalCobro"
        tabindex="-1"
        aria-hidden="true"
    >

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Recibir cobro
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    ></button>

                </div>

                <div class="modal-body" id="modalCobroBody">

                    <div class="text-center py-4">
                        Cargando...
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div
        class="modal fade"
        id="modalGastos"
        tabindex="-1"
        aria-hidden="true"
    >

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Gastos del proyecto
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    ></button>

                </div>

                <div class="modal-body" id="modalGastosBody">

                    <div class="text-center py-4">
                        Cargando...
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="modal fade"
        id="modalNuevoCobroProyecto"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <form method="post"
                    id="formNuevoCobroProyecto">

                    <div class="modal-header">

                        <div>
                            <h5 class="modal-title">
                                Registrar cobro
                            </h5>

                            <div class="text-muted small"
                                id="nuevoCobroCliente">
                            </div>
                        </div>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body row g-3">

                        <div class="col-6">

                            <label class="form-label">
                                Fecha
                            </label>

                            <input
                                type="date"
                                name="fecha"
                                class="form-control form-control-sm"
                                value="{{ 'now'|date('Y-m-d') }}"
                                required
                            >

                        </div>

                        <div class="col-6">

                            <label class="form-label">
                                Método
                            </label>

                            <select
                                name="metodo"
                                class="form-select form-select-sm"
                                required
                            >
                                <option value="efectivo">Efectivo</option>
                                <option value="tarjeta">Tarjeta</option>
                                <option value="transferencia">Transferencia</option>
                                <option value="bizum">Bizum</option>
                                <option value="financiacion">Financiación</option>
                            </select>

                        </div>

                        <div class="col-6">

                            <label class="form-label">
                                Importe bruto
                            </label>

                            <div class="input-group input-group-sm">

                                <input
                                    type="number"
                                    name="importeBruto"
                                    id="nuevoCobroImporte"
                                    class="form-control"
                                    step="0.01"
                                    min="0.01"
                                    required
                                >

                                <span class="input-group-text">
                                    €
                                </span>

                            </div>

                            <div class="form-text"
                                id="nuevoCobroPendiente">
                            </div>

                        </div>

                        <div class="col-6">

                            <label class="form-label">
                                % Recargo
                            </label>

                            <div class="input-group input-group-sm">

                                <input
                                    type="number"
                                    name="porcentajeRecargo"
                                    class="form-control"
                                    step="0.01"
                                    min="0"
                                    value="0"
                                >

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                        </div>

                        <input type="hidden"
                            name="importeRecargo"
                            value="0">

                        <input type="hidden"
                            name="importeNeto"
                            value="0">


                        <div class="col-12">

                            <label class="form-label">
                                Referencia
                            </label>

                            <input
                                type="text"
                                name="referencia"
                                class="form-control form-control-sm"
                                placeholder="Transferencia, VISA *1234..."
                            >

                        </div>


                        <div class="col-12">

                            <label class="form-label">
                                Notas
                            </label>

                            <textarea
                                name="notas"
                                class="form-control form-control-sm"
                                rows="2">
                            </textarea>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-sm btn-secondary"
                            data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button
                            type="submit"
                            class="btn btn-sm btn-primary">
                            Guardar cobro
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>    

    {# =============================================================
    MODAL MARCAR GASTO COMO PAGADO
    ============================================================= #}
    <div class="modal fade" id="modalGastoPagado" tabindex="-1">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Marcar gasto como pagado
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <div class="text-muted small">
                            Gasto
                        </div>

                        <div
                            class="fw-semibold"
                            id="gastoPagadoConcepto">
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Importe
                        </div>

                        <div
                            class="fw-semibold"
                            id="gastoPagadoImporte">
                        </div>
                    </div>

                    <div class="alert alert-light border">
                        ¿Cómo se ha realizado el pago?
                    </div>

                    <div class="d-grid gap-2">

                        <button
                            type="button"
                            class="btn btn-outline-success"
                            id="btnGastoPagoEfectivo">

                            <i class="bi bi-cash me-1"></i>
                            Efectivo
                        </button>

                        <button
                            type="button"
                            class="btn btn-outline-primary"
                            id="btnGastoPagoBanco">

                            <i class="bi bi-bank me-1"></i>
                            Banco / tarjeta / transferencia / Bizum
                        </button>

                    </div>

                </div>

            </div>
        </div>

    </div>    

{% endblock %}


{% block jscustom %}

    {{ parent() }}

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            /*
             * =========================================================
             * COBRO
             * =========================================================
             */
            document
                .querySelectorAll('.btn-cobro')
                .forEach(function (boton) {

                    boton.addEventListener(
                        'click',
                        function () {

                            const proyectoId =
                                this.dataset.proyecto;

                            const pendiente =
                                this.dataset.pendiente;

                            console.log(
                                'Cobro proyecto:',
                                proyectoId,
                                'Pendiente:',
                                pendiente
                            );

                            const modalElement =
                                document.getElementById(
                                    'modalCobro'
                                );

                            const modal =
                                bootstrap.Modal
                                    .getOrCreateInstance(
                                        modalElement
                                    );

                            document.getElementById(
                                'modalCobroBody'
                            ).innerHTML = `
                                <div class="text-center py-4">
                                    Formulario de cobro
                                    del proyecto
                                    <strong>
                                        #${proyectoId}
                                    </strong>
                                </div>
                            `;

                            modal.show();

                        }
                    );

                });


            /*
             * =========================================================
             * GASTOS
             * =========================================================
             */
            document
                .querySelectorAll('.btn-gastos')
                .forEach(function (boton) {

                    boton.addEventListener(
                        'click',
                        function () {

                            const proyectoId =
                                this.dataset.proyecto;

                            console.log(
                                'Gastos proyecto:',
                                proyectoId
                            );

                            const modalElement =
                                document.getElementById(
                                    'modalGastos'
                                );

                            const modal =
                                bootstrap.Modal
                                    .getOrCreateInstance(
                                        modalElement
                                    );

                            document.getElementById(
                                'modalGastosBody'
                            ).innerHTML = `
                                <div class="text-center py-4">
                                    Gastos del proyecto
                                    <strong>
                                        #${proyectoId}
                                    </strong>
                                </div>
                            `;

                            modal.show();

                        }
                    );

                });

        });

    </script>
    <script src="{{ asset('assets/js/proyecto/proyecto-gasto.js') }}"></script>
    <script src="{{ asset('assets/js/proyecto/proyecto-cobro.js') }}"></script>
    <script src="{{ asset('assets/js/proyecto/proyecto-presupuesto.js') }}"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const modalElement =
                document.getElementById('modalGastosPendientes');

            const modalBody =
                document.getElementById('modalGastosPendientesBody');

            if (!modalElement || !modalBody) {
                return;
            }

            document.addEventListener('click', async function (e) {

                const boton = e.target.closest('.btnGastosPendientes');

                if (!boton) {
                    return;
                }

                e.preventDefault();

                const url = boton.dataset.url;

                if (!url) {
                    return;
                }

                modalBody.innerHTML = `
                    <div class="text-muted py-3">
                        Cargando gastos...
                    </div>
                `;

                let modal =
                    bootstrap.Modal.getInstance(modalElement);

                if (!modal) {
                    modal = new bootstrap.Modal(modalElement);
                }

                modal.show();

                try {

                    const response = await fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const html = await response.text();

                    if (!response.ok) {

                        modalBody.innerHTML = `
                            <div class="alert alert-danger mb-0">
                                No se pudieron cargar los gastos.
                            </div>
                        `;

                        return;
                    }

                    modalBody.innerHTML = html;

                } catch (error) {

                    console.error(
                        'Error cargando gastos pendientes:',
                        error
                    );

                    modalBody.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            No se pudieron cargar los gastos.
                        </div>
                    `;
                }

            });

        });
    </script>

    
{% endblock %}
