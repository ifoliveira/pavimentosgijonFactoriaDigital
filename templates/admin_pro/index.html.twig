{% extends 'base.html.twig' %}

{% block title %}Resumen de ventas{% endblock %}

{% block body %}
{% set meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}
{% set totalVentas = totalTpv + totalProyectos %}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Resumen de ventas</h1>
            <p class="text-muted mb-0">Cobros reales registrados durante el ejercicio: TPV y proyectos.</p>
        </div>
        <form method="get">
            <label for="anio" class="form-label small mb-1">Ejercicio</label>
            <select name="anio" id="anio" class="form-select" onchange="this.form.submit()">
                {% for año in ('now'|date('Y') - 5)..('now'|date('Y')) %}
                    <option value="{{ año }}" {{ año == anio ? 'selected' : '' }}>{{ año }}</option>
                {% endfor %}
            </select>
        </form>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Cobrado por TPV</div><div class="fs-4 fw-bold">{{ totalTpv|format_currency('EUR', locale='es') }}</div><div class="small text-muted">Tickets y sus rectificaciones</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Cobrado en proyectos</div><div class="fs-4 fw-bold text-primary">{{ totalProyectos|format_currency('EUR', locale='es') }}</div><div class="small text-muted">Cobros añadidos a proyectos</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Total cobrado</div><div class="fs-4 fw-bold text-success">{{ totalVentas|format_currency('EUR', locale='es') }}</div><div class="small text-muted">Ejercicio {{ anio }}</div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Evolución de cobros</h2></div>
        <div class="card-body"><div id="grafico-ventas" style="min-height: 320px"></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Cobros por mes</h2></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-4">Mes</th><th class="text-end">TPV</th><th class="text-end">Proyectos</th><th class="text-end pe-4">Total</th></tr></thead>
                <tbody>
                {% for numero, mes in meses %}
                    {% set indice = numero + 1 %}
                    {% set totalMes = tpvPorMes[indice] + proyectosPorMes[indice] %}
                    <tr>
                        <td class="ps-4 fw-semibold">{{ mes }}</td>
                        <td class="text-end">{{ tpvPorMes[indice]|format_currency('EUR', locale='es') }}</td>
                        <td class="text-end">{{ proyectosPorMes[indice]|format_currency('EUR', locale='es') }}</td>
                        <td class="text-end pe-4 fw-bold">{{ totalMes|format_currency('EUR', locale='es') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot class="table-light"><tr><th class="ps-4">Total</th><th class="text-end">{{ totalTpv|format_currency('EUR', locale='es') }}</th><th class="text-end">{{ totalProyectos|format_currency('EUR', locale='es') }}</th><th class="text-end pe-4">{{ totalVentas|format_currency('EUR', locale='es') }}</th></tr></tfoot>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block jscustom %}
<script src="{{ asset('assets/libs/apexcharts/dist/apexcharts.min.js') }}"></script>
<script>
    new ApexCharts(document.querySelector('#grafico-ventas'), {
        chart: { type: 'bar', height: 320, stacked: true, toolbar: { show: false } },
        series: [
            { name: 'TPV', data: {{ datosTpvGrafico|json_encode|raw }} },
            { name: 'Proyectos', data: {{ datosProyectosGrafico|json_encode|raw }} }
        ],
        xaxis: { categories: {{ mesesGrafico|json_encode|raw }} },
        yaxis: { labels: { formatter: function (valor) { return valor.toLocaleString('es-ES') + ' €'; } } },
        tooltip: { y: { formatter: function (valor) { return valor.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; } } },
        colors: ['#2962ff', '#26c6da'],
        legend: { position: 'top' },
        dataLabels: { enabled: false },
        stroke: { width: 1, colors: ['#fff'] }
    }).render();
</script>
{% endblock %}
