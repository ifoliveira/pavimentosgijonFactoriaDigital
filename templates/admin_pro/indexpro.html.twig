{% extends 'base.html.twig' %}

{% block title %}Administración Pavimentos Gijón{% endblock %}

{% block body %}
    {# Variables globales para dashboardNew.js — deben estar en el HTML antes de los scripts #}
    <script>
        var forecast         = {{ forecastChartData|json_encode|raw }};
        var gastosAcumulados = {{ resumenAnual.gastosAcumulados|json_encode|raw }};
        var bancoTotal       = {{ bancototal['sum(importe_bn)']|number_format(2, '.', '') }};
        var efectivoTotal    = {{ gastos['efectivototal']|number_format(2, '.', '') }};
        var saldoefectivoLine = gastosAcumulados.map(item => ({ x: item.x, y: efectivoTotal }));
        var bancoLine        = gastosAcumulados.map(item => ({ x: item.x, y: bancoTotal }));
        var bancoCajaLine    = gastosAcumulados.map(item => ({ x: item.x, y: bancoTotal + efectivoTotal }));
    </script>

    {# resto del HTML... #}
    <div class="card">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                <div>
                    <h1 class="h3 mb-1">Flujo de caja</h1>
                    <p class="text-muted mb-0">Previsión de tesorería del ejercicio {{ anio|default(resumenAnual.anio) }}.</p>
                </div>
                <form method="get">
                    <label for="anio-flujo-caja" class="form-label small mb-1">Ejercicio</label>
                    <select name="anio" id="anio-flujo-caja" class="form-select" onchange="this.form.submit()">
                        {% for ejercicio in aniosDisponibles|default([resumenAnual.anio]) %}
                            <option value="{{ ejercicio }}" {{ ejercicio == (anio|default(resumenAnual.anio)) ? 'selected' : '' }}>{{ ejercicio }}</option>
                        {% endfor %}
                    </select>
                </form>
            </div>

            {# Tarjetas resumen #}
            <div class="row">
                <div class="col-lg-4 d-flex align-items-stretch">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="mr-3 align-self-center">
                                    <span class="lstick d-inline-block align-middle mr-3"></span>
                                </div>
                                <div class="align-self-center">
                                    <h6 class="text-muted mt-2 mb-0">Banco a {{ bancototal['max(fecha_bn)']|date('d/m/Y') }}</h6>
                                    <h2 id="bancototal" data-banco="{{ bancototal['sum(importe_bn)'] }}">
                                        {{ bancototal['sum(importe_bn)']|format_currency('EUR', locale='es') }}
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 d-flex align-items-stretch">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="mr-3 align-self-center">
                                    <span class="lstick d-inline-block align-middle mr-3"></span>
                                </div>
                                <div class="align-self-center">
                                    <h6 class="text-muted mt-2 mb-0">Efectivo</h6>
                                    <h2 id="efectivototal" data-caja="{{ gastos['efectivototal'] }}">
                                        {{ gastos['efectivototal']|format_currency('EUR', locale='es') }}
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 d-flex align-items-stretch">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="mr-3 align-self-center">
                                    <span class="lstick d-inline-block align-middle mr-3"></span>
                                </div>
                                <div class="align-self-center">
                                    <h6 class="text-muted mt-2 mb-0">Total</h6>
                                    <h2 id="cajatotal" data-caja="{{ bancototal['sum(importe_bn)'] + gastos['efectivototal'] }}">
                                        {{ (bancototal['sum(importe_bn)'] + gastos['efectivototal'])|format_currency('EUR', locale='es') }}
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Gráfica flujo de caja #}
            <div class="col-lg-12 d-flex align-items-stretch">
                <div class="card w-100">
                    <div class="card-body">
                        <div class="d-md-flex">
                            <h4 class="card-title">
                                <span class="lstick d-inline-block align-middle"></span>Flujo de caja · {{ anio|default(resumenAnual.anio) }}
                            </h4>
                            <ul class="list-inline mb-0 ms-auto">
                                <li class="list-inline-item">
                                    <h6 style="color:#8fd3b5"><i class="ri-checkbox-blank-circle-fill align-middle fs-4 font-10 me-2" style="color:#8fd3b5"></i>Saldo banco previsto</h6>
                                </li>
                                <li class="list-inline-item">
                                    <h6 style="color:#8fb8df"><i class="ri-checkbox-blank-circle-fill align-middle fs-4 font-10 me-2" style="color:#8fb8df"></i>Saldo Banco</h6>
                                </li>
                                <li class="list-inline-item">
                                    <h6 style="color:#e7b3d1"><i class="ri-checkbox-blank-circle-fill align-middle fs-4 font-10 me-2" style="color:#e7b3d1"></i>Saldo Efectivo</h6>
                                </li>
                                <li class="list-inline-item">
                                    <h6 style="color:#f2c48f"><i class="ri-checkbox-blank-circle-fill align-middle fs-4 font-10 me-2" style="color:#f2c48f"></i>Banco + Efectivo</h6>
                                </li>
                                <li class="list-inline-item">
                                    <h6 style="color:#dc5960">Gasto acumulado</h6>
                                </li>
                            </ul>
                        </div>
                        <p class="small text-muted">Gasto acumulado diario desde {{ resumenAnual.fechaCorte|date('d/m/Y') }}: vencimientos pendientes, facturas sin vencimiento completo y bolsa prevista. Los saldos de referencia son los disponibles hoy. Las curvas suavizan la presentación; los cruces se calculan con el total al cierre de cada día.</p>
                        <div id="cruces-gasto" class="d-flex flex-wrap gap-3 small mb-3"></div>
                        <div id="Website-Visit" class="position-relative mt-4" style="height:400px; width:100%"></div>
                    </div>
                </div>
            </div>

            {% set bolsa = resumenAnual.bolsa %}
            <div class="card mt-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Previsión de pagos de {{ resumenAnual.anio }}</h4>
                            <p class="text-muted mb-0">Vencimientos registrados y compras previstas que todavía no han llegado en factura.</p>
                        </div>
                        <a class="btn btn-outline-primary" href="{{ path('admin_bolsa_gastos') }}">Configurar bolsa de gastos</a>
                    </div>
                    {% if not bolsa.activo %}
                        <div class="alert alert-info">
                            {% if bolsa.configuracion.fechaInicio %}
                                La bolsa empezará a contar el {{ bolsa.configuracion.fechaInicio|date('d/m/Y') }}. Hasta entonces se muestran los vencimientos registrados.
                            {% else %}
                                La bolsa de gastos está sin activar. Elige la fecha de inicio en su configuración. Por ahora se muestran los vencimientos registrados.
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 col-xl-3"><div class="border rounded p-3 h-100"><div class="small text-muted">Vencimientos pendientes</div><div class="h4 mb-0 text-danger">{{ resumenAnual.pagosForecast|number_format(2, ',', '.') }} €</div><small class="text-muted">Pagos registrados hasta fin de año</small></div></div>
                        <div class="col-md-6 col-xl-3"><div class="border rounded p-3 h-100"><div class="small text-muted">Facturas sin vencimiento completo</div><div class="h4 mb-0 text-danger">{{ resumenAnual.pagosSinVencimiento|number_format(2, ',', '.') }} €</div><small class="text-muted">Importe recibido, fecha de pago estimada</small></div></div>
                        <div class="col-md-6 col-xl-3"><div class="border rounded p-3 h-100"><div class="small text-muted">Pendiente de recibir en facturas</div><div class="h4 mb-0 text-warning">{{ resumenAnual.bolsaConIva|number_format(2, ',', '.') }} €</div><small class="text-muted">Bolsa prevista hasta fin de año, IVA estimado incluido</small></div></div>
                        <div class="col-md-6 col-xl-3"><div class="border border-primary rounded p-3 h-100"><div class="small text-muted">Total previsto de pagos</div><div class="h4 mb-0">{{ resumenAnual.salidasPendientesEstimadas|number_format(2, ',', '.') }} €</div><small class="text-muted">Vencimientos + facturas sin fecha + bolsa pendiente</small></div></div>
                    </div>
                    {% if bolsa.activo %}
                        <p class="small text-muted">Bolsa desde {{ bolsa.configuracion.fechaInicio|date('d/m/Y') }}: {{ bolsa.saldoBase|number_format(2, ',', '.') }} € sin IVA pendientes, más {{ bolsa.saldoIva|number_format(2, ',', '.') }} € de IVA estimado ({{ bolsa.configuracion.ivaEstimado|number_format(2, ',', '.') }} %). Las facturas la consumen aunque no se asignen a una obra. Pagar o asignar una factura no vuelve a descontarla.</p>
                        {% if resumenAnual.bolsaPosteriorAnio > 0 %}
                            <p class="small text-muted">Otros {{ resumenAnual.bolsaPosteriorAnio|number_format(2, ',', '.') }} € de la bolsa están previstos para después de este año.</p>
                        {% endif %}
                        {% if bolsa.incidencias is not empty %}
                            <p class="text-warning">Hay {{ bolsa.incidencias|length }} aviso(s) en la bolsa. <a href="{{ path('admin_bolsa_gastos') }}">Ver detalle</a></p>
                        {% endif %}
                    {% endif %}

                    {% if bolsa.facturasSinVencimiento is not empty %}
                        <details class="mb-3">
                            <summary>Ver facturas con importes todavía sin vencimiento</summary>
                            <p class="small text-muted mt-2">Se cuenta solo la parte que falta en sus vencimientos. Al completarlos, esa parte pasa automáticamente al calendario real.</p>
                            <div class="table-responsive"><table class="table table-sm">
                                <thead><tr><th>Factura</th><th>Pago estimado</th><th class="text-end">Importe sin vencimiento</th></tr></thead>
                                <tbody>{% for pendiente in bolsa.facturasSinVencimiento %}
                                    <tr><td><a href="{{ path('factura_proveedor_show', {id: pendiente.factura.id}) }}">{{ pendiente.factura.proveedorNombre }} · {{ pendiente.factura.numeroFactura ?: pendiente.factura.id }}</a></td><td>{{ pendiente.fecha|date('d/m/Y') }}</td><td class="text-end">{{ pendiente.importe|number_format(2, ',', '.') }} €</td></tr>
                                {% endfor %}</tbody>
                            </table></div>
                        </details>
                    {% endif %}
                    <div class="row g-3 my-3">
                        <div class="col-md-4"><div class="small text-muted">{{ resumenAnual.anio > ('now'|date('Y')) ? 'Saldo previsto al comenzar ' ~ resumenAnual.anio : 'Disponible hoy' }}</div><div class="h4">{{ (resumenAnual.anio > ('now'|date('Y')) ? resumenAnual.saldoInicialAnio : resumenAnual.saldoActual)|number_format(2, ',', '.') }} €</div></div>
                        <div class="col-md-4"><div class="small text-muted">Cobros pendientes de proyectos estimados</div><div class="h4 text-success">{{ resumenAnual.cobrosProyectoEstimados|number_format(2, ',', '.') }} €</div></div>
                        <div class="col-md-4"><div class="small text-muted">Saldo proyectado a fin de año</div><div class="h4 {{ resumenAnual.saldoProyectadoFinAnio >= 0 ? 'text-success' : 'text-danger' }}">{{ resumenAnual.saldoProyectadoFinAnio|number_format(2, ',', '.') }} €</div></div>
                    </div>
                    {% if resumenAnual.anio > ('now'|date('Y')) %}
                        <p class="small text-muted">
                            El saldo inicial de {{ resumenAnual.anio }} parte de los {{ resumenAnual.saldoActual|number_format(2, ',', '.') }} € disponibles hoy
                            y aplica los cobros y pagos pendientes anteriores al 01/01/{{ resumenAnual.anio }}
                            (variación: {{ resumenAnual.variacionAntesAnio > 0 ? '+' : '' }}{{ resumenAnual.variacionAntesAnio|number_format(2, ',', '.') }} €).
                        </p>
                    {% endif %}
                    {% if resumenAnual.bolsaPendientesAnio is not empty %}
                        <details class="mb-3">
                            <summary>Ver desglose de la bolsa previsto para {{ resumenAnual.anio }}</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Pago previsto</th><th>Origen</th><th class="text-end">Sin IVA</th><th class="text-end">IVA estimado</th><th class="text-end">Total</th></tr></thead>
                                    <tbody>{% for pendiente in resumenAnual.bolsaPendientesAnio %}
                                        <tr>
                                            <td>{{ pendiente.fechaPrevista|date('d/m/Y') }}</td>
                                            <td>{{ pendiente.concepto|default('Compra pendiente') }}</td>
                                            <td class="text-end">{{ (pendiente.restanteCentimos / 100)|number_format(2, ',', '.') }} €</td>
                                            <td class="text-end">{{ (pendiente.ivaCentimos / 100)|number_format(2, ',', '.') }} €</td>
                                            <td class="text-end fw-semibold">{{ (pendiente.totalCentimos / 100)|number_format(2, ',', '.') }} €</td>
                                        </tr>
                                    {% endfor %}</tbody>
                                </table>
                            </div>
                        </details>
                    {% endif %}
                    <p class="small text-muted">La gráfica superior muestra el saldo bancario según los vencimientos registrados y el gasto acumulado incluyendo las facturas sin vencimiento completo y la bolsa pendiente. La proyección mensual añade los cobros de proyectos, las facturas sin vencimiento completo y la bolsa pendiente con fechas estimadas.</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Mes {{ resumenAnual.anio }}</th><th class="text-end">Cobros registrados</th><th class="text-end">Cobros proyectos</th><th class="text-end">Pagos registrados</th><th class="text-end">Facturas sin fecha</th><th class="text-end">Bolsa pendiente (IVA incl.)</th><th class="text-end">Saldo proyectado</th></tr></thead>
                            <tbody>{% for mes in resumenAnual.meses %}
                                <tr class="{{ mes.pasado ? 'text-muted' : '' }}">
                                    <td>{{ mes.nombre }}</td>
                                    <td class="text-end text-success">{{ mes.cobrosForecast|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end text-success">{{ mes.cobrosProyectoEstimados|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end text-danger">{{ mes.pagosForecast|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end text-danger">{{ mes.pagosSinVencimiento|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end text-warning">{{ mes.bolsaGastos|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end fw-semibold {{ mes.saldoProyectado >= 0 ? 'text-success' : 'text-danger' }}">{{ mes.saldoProyectado|number_format(2, ',', '.') }} €</td>
                                </tr>
                            {% endfor %}</tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Anchors de datos para el script #}
            {% for movifore in forecast %}
                <a id="forecast{{ loop.index0 }}"  class="{{ movifore.getOrigenFr }}" data-venta="{{ (movifore.getImporteFr * -1)|number_format(2, '.', '') }}"></a>
                <a id="fechfore{{ loop.index0 }}" class="{{ movifore.getOrigenFr }}" data-venta="{{ movifore.getFechaFr|date('Y-m-d') }}"></a>
            {% endfor %}

        </div>
    </div>
{% endblock %}

{% block jscustom %}
    <script src="{{ asset('assets/libs/apexcharts/dist/apexcharts.min.js') }}"></script>
    <script src="{{ asset('dist/js/pages/dashboards/dashboardNew.js') }}"></script>
{% endblock %}
