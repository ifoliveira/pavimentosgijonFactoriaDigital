{% if cobros is empty %}

    <div class="alert alert-light border mb-0">
        No hay cobros registrados para este proyecto.
    </div>

{% else %}

    <div class="mb-3">
        <div class="fw-semibold">
            {{ proyecto.nombre }}
        </div>

        <div class="text-muted small">
            {{ proyecto.cliente.nombreCl }}

            {% if proyecto.cliente.apellidosCl %}
                {{ proyecto.cliente.apellidosCl }}
            {% endif %}
        </div>
    </div>

    <div class="table-responsive">

        <table class="table table-sm align-middle mb-0">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Método</th>
                    <th class="text-end">Importe</th>
                    <th>Referencia</th>
                    <th class="text-end"></th>
                </tr>
            </thead>

            <tbody>

                {% for cobro in cobros %}

                    <tr>

                        <td>
                            {{ cobro.fecha|date('d/m/Y') }}
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                {{ cobro.metodo }}
                            </span>
                        </td>

                        <td class="text-end fw-semibold">
                            {{ cobro.importeBruto
                                | format_currency('EUR', locale='es')
                            }}
                        </td>

                        <td>
                            {{ cobro.referencia ?: '—' }}
                        </td>

                        <td class="text-end">

                            <a
                                href="{{ path(
                                    'proyecto_cobro_justificante_pdf',
                                    {id: cobro.id}
                                ) }}"
                                target="_blank"
                                class="btn btn-sm btn-outline-dark"
                            >
                                <i class="bi bi-printer me-1"></i>
                                Justificante
                            </a>

                        </td>

                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

{% endif %}