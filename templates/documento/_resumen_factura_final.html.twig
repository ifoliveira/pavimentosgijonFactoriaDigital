{% set resumenObra = documento.resumenFacturaFinal %}
{% if resumenObra %}
    <div style="page-break-inside: avoid; margin: 16px 0; padding: 14px; border: 1px solid #cbd5e1; background: #f8fafc; color: #172b4d;">
        <div style="font-size: 15px; font-weight: bold; margin-bottom: 8px;">Resumen económico de la obra</div>
        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
            <tr style="font-size: 16px; font-weight: bold;">
                <td style="padding: 7px 0;">Coste total de la obra (IVA incluido)</td>
                <td style="padding: 7px 0; text-align: right; white-space: nowrap;">{{ resumenObra.totalObra|number_format(2, ',', '.') }} €</td>
            </tr>
            <tr>
                <td style="padding: 5px 0;">Anticipos ya facturados y descontados (IVA incluido)</td>
                <td style="text-align: right; white-space: nowrap;">− {{ resumenObra.anticipos|number_format(2, ',', '.') }} €</td>
            </tr>
            <tr>
                <td style="padding: 5px 0;">Importe de esta factura final (IVA incluido)</td>
                <td style="text-align: right; white-space: nowrap;">{{ resumenObra.totalFactura|number_format(2, ',', '.') }} €</td>
            </tr>
            <tr>
                <td style="padding: 5px 0;">Pagos aplicados a esta factura final</td>
                <td style="text-align: right; white-space: nowrap;">− {{ resumenObra.cobradoFactura|number_format(2, ',', '.') }} €</td>
            </tr>
            <tr style="font-size: 14px; font-weight: bold;">
                <td style="padding: 8px 0; border-top: 1px solid #cbd5e1;">Saldo pendiente de pago</td>
                <td style="padding: 8px 0; border-top: 1px solid #cbd5e1; text-align: right; white-space: nowrap;">{{ resumenObra.pendiente|number_format(2, ',', '.') }} €</td>
            </tr>
        </table>
        <div style="font-size: 10px; margin-top: 5px;">El coste total incluye las partidas de obra detalladas en este documento. Los anticipos se descuentan una sola vez.</div>
    </div>
{% endif %}
