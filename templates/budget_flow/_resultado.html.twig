{% if resultado %}

    <div class="card mt-4">

        <div class="card-header">
            <h3 class="card-title mb-0">
                Resultado
            </h3>
        </div>

        <div class="card-body">

            {# AVISOS #}
            {% if resultado.avisos is defined and resultado.avisos|length > 0 %}

                {% for aviso in resultado.avisos %}
                    <div class="alert alert-warning">
                        {{ aviso.mensaje ?? aviso }}
                    </div>
                {% endfor %}

            {% endif %}


            {# LÍNEAS GENERADAS #}
            {% if resultado.lineas is defined and resultado.lineas|length > 0 %}

                <div class="table-responsive">

                    <table class="table table-striped align-middle budget-flow-result-table">

                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end">Cantidad</th>
                                <th>Unidad</th>
                                <th class="text-end">Coste unitario</th>
                                <th class="text-end">Precio unitario</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Base</th>
                                <th class="text-end">IVA €</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for linea in resultado.lineas %}

                                <tr>

                                    <td class="budget-flow-result-description" title="{{ linea.descripcion }}">
                                        {{ linea.descripcion }}
                                    </td>

                                    <td class="text-end budget-flow-result-number">
                                        {{ linea.cantidad|number_format(2, ',', '.') }}
                                    </td>

                                    <td class="budget-flow-result-number">
                                        {{ linea.unidad }}
                                    </td>
                                    <td class="text-end budget-flow-result-number">
                                        {% if linea.costeUnitarioSinIva %} 
                                            {{ linea.costeUnitarioSinIva|number_format(2, ',', '.') }} €
                                        {% else %}
                                            Coste desconocido
                                        {% endif %}
                                    </td>
                                    <td class="text-end budget-flow-result-number">
                                        {{ linea.precioUnitarioSinIva|number_format(2, ',', '.') }} €
                                    </td>

                                    <td class="text-end budget-flow-result-number">
                                        {{ linea.tipoIva|number_format(2, ',', '.') }} %
                                    </td>

                                    <td class="text-end budget-flow-result-number">
                                        {{ linea.importeBase|number_format(2, ',', '.') }} €
                                    </td>

                                    <td class="text-end budget-flow-result-number">
                                        {{ linea.importeIva|number_format(2, ',', '.') }} €
                                    </td>

                                    <td class="text-end fw-bold budget-flow-result-number">
                                        {{ linea.importeTotal|number_format(2, ',', '.') }} €
                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            {% else %}

                <div class="alert alert-info mb-0">
                    El configurador no ha generado ninguna línea.
                </div>

            {% endif %}

        </div>

    </div>

{% endif %}

<style>
    .budget-flow-result-table {
        min-width: 980px;
        margin-bottom: 0;
        table-layout: fixed;
        font-size: .78rem;
    }

    .budget-flow-result-table th,
    .budget-flow-result-table td {
        padding: .55rem .45rem;
        line-height: 1.25;
        vertical-align: middle;
        white-space: nowrap;
    }

    .budget-flow-result-table th:first-child,
    .budget-flow-result-table td:first-child {
        width: 25%;
    }

    .budget-flow-result-description {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .budget-flow-result-number {
        width: 9.375%;
    }
</style>
