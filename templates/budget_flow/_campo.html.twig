{% set grupo = grupo ?? null %}

{% set nombreCampo = grupo
    ? 'valores[' ~ grupo ~ '][' ~ campo.codigo ~ ']'
    : 'valores[' ~ campo.codigo ~ ']'
%}

{% set valoresGrupo = grupo
    ? (valores[grupo] ?? {})
    : valores
%}

{% set valorActual = valoresGrupo[campo.codigo] ?? campo.valorDefecto ?? null %}
{% set campoId = grupo ? grupo ~ '_' ~ campo.codigo : campo.codigo %}
{% set opciones = campo.opciones ?? [] %}
{% set usarOpcionesCompactas = campo.tipo == 'seleccion' and opciones|length >= 2 and opciones|length <= 4 %}

<div class="budget-flow-field budget-flow-field--{{ campo.tipo == 'seleccion' and usarOpcionesCompactas ? 'selection-buttons' : campo.tipo }}">

    <label
        {% if campo.tipo == 'booleano' or usarOpcionesCompactas %}
            id="{{ campoId }}_label"
        {% else %}
            for="{{ campoId }}"
        {% endif %}
        class="budget-flow-field-label"
    >
        {{ campo.etiqueta ?? campo.codigo }}

        {% if campo.obligatorio ?? false %}
            <span class="text-danger budget-flow-required" aria-label="Obligatorio">*</span>
        {% endif %}
    </label>

    {# ENTERO #}
    {% if campo.tipo == 'entero' %}

        <input
            type="number"
            class="form-control budget-flow-control"
            id="{{ campoId }}"
            name="{{ nombreCampo }}"
            value="{{ valorActual ?? ''}}"
            {% if campo.obligatorio ?? false %}required{% endif %}
        >


    {# DECIMAL #}
    {% elseif campo.tipo == 'decimal' %}

        <input
            type="number"
            step="any"
            class="form-control budget-flow-control"
            id="{{ campoId }}"
            name="{{ nombreCampo }}"
            value="{{ valorActual ?? ''}}"
            {% if campo.obligatorio ?? false %}required{% endif %}
        >


    {# BOOLEANO #}
    {% elseif campo.tipo == 'booleano' %}


        <div class="budget-flow-choice-group" role="radiogroup" aria-labelledby="{{ campoId }}_label">
            {% set booleanActual = valorActual in [true, 1, '1', 'true'] %}

            <span class="budget-flow-choice">
                <input
                    type="radio"
                    class="budget-flow-choice-input"
                    id="{{ campoId }}_no"
                    name="{{ nombreCampo }}"
                    value="0"
                    {% if not booleanActual %}checked{% endif %}
                >
                <label class="budget-flow-choice-label" for="{{ campoId }}_no">
                    No
                </label>
            </span>

            <span class="budget-flow-choice">
                <input
                    type="radio"
                    class="budget-flow-choice-input"
                    id="{{ campoId }}_si"
                    name="{{ nombreCampo }}"
                    value="1"
                    {% if booleanActual %}checked{% endif %}
                >
                <label class="budget-flow-choice-label" for="{{ campoId }}_si">
                    Sí
                </label>
            </span>
        </div>


    {# SELECCIÓN #}
    {% elseif campo.tipo == 'seleccion' %}

        {% if usarOpcionesCompactas %}

            <div class="budget-flow-choice-group" role="radiogroup" aria-labelledby="{{ campoId }}_label">
                {% if not (campo.obligatorio ?? false) %}
                    <span class="budget-flow-choice">
                        <input
                            type="radio"
                            class="budget-flow-choice-input"
                            id="{{ campoId }}_none"
                            name="{{ nombreCampo }}"
                            value=""
                            {% if valorActual is same as(null) or valorActual == '' %}checked{% endif %}
                        >
                        <label class="budget-flow-choice-label" for="{{ campoId }}_none">
                            Sin preferencia
                        </label>
                    </span>
                {% endif %}

                {% for opcion in opciones %}
                    {% set opcionValor = opcion.codigo ?? opcion.value ?? opcion.valor ?? '' %}
                    {% set opcionEtiqueta = opcion.etiqueta ?? opcion.label ?? opcion.nombre ?? opcionValor %}

                    <span class="budget-flow-choice">
                        <input
                            type="radio"
                            class="budget-flow-choice-input"
                            id="{{ campoId }}_{{ loop.index }}"
                            name="{{ nombreCampo }}"
                            value="{{ opcionValor }}"
                            {% if campo.obligatorio ?? false %}required{% endif %}
                            {% if valorActual == opcionValor %}checked{% endif %}
                        >
                        <label class="budget-flow-choice-label" for="{{ campoId }}_{{ loop.index }}">
                            {{ opcionEtiqueta }}
                        </label>
                    </span>
                {% endfor %}
            </div>

        {% else %}

            <select
                class="form-select budget-flow-control"
                id="{{ campoId }}"
                name="{{ nombreCampo }}"
                {% if campo.obligatorio ?? false %}required{% endif %}
            >

                <option value="">
                    {{ (campo.obligatorio ?? false) ? 'Selecciona una opción' : 'Sin preferencia' }}
                </option>

                {% for opcion in opciones %}
                    {% set opcionValor = opcion.codigo ?? opcion.value ?? opcion.valor ?? '' %}
                    {% set opcionEtiqueta = opcion.etiqueta ?? opcion.label ?? opcion.nombre ?? opcionValor %}

                    <option
                        value="{{ opcionValor }}"
                        {% if valorActual == opcionValor %}selected{% endif %}
                    >
                        {{ opcionEtiqueta }}
                    </option>
                {% endfor %}

            </select>

        {% endif %}


    {# TEXTO Y CUALQUIER TIPO NO RECONOCIDO #}
    {% else %}

        <input
            type="text"
            class="form-control budget-flow-control"
            id="{{ campoId }}"
            name="{{ nombreCampo }}"
            value="{{ valorActual ?? ''}}"
            {% if campo.obligatorio ?? false %}required{% endif %}
        >

    {% endif %}


    {% if campo.ayuda ?? false %}
        <div class="budget-flow-help">
            {{ campo.ayuda }}
        </div>
    {% endif %}



</div>
