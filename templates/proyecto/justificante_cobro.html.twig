{% extends 'base.html.twig' %}

{% block title %}Justificante de cobro #{{ cobro.id }}{% endblock %}
{% block cabecera %}Justificante de cobro{% endblock %}

{% block body %}
<div class="container-fluid py-3">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    <div class="card mx-auto" style="max-width: 760px;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h4 mb-0">Justificante de cobro #{{ cobro.id }}</h1>
                <span class="badge bg-success">Registrado</span>
            </div>
            <div class="text-muted">{{ proyecto.nombre }}</div>
            {% if proyecto.cliente %}<div>{{ proyecto.cliente.nombreCl }} {{ proyecto.cliente.apellidosCl }}</div>{% endif %}
            <div class="bg-light rounded p-3 my-3">
                <div class="text-muted">Importe recibido</div>
                <div class="h2 text-success mb-0">{{ cobro.importeBruto|number_format(2, ',', '.') }} €</div>
            </div>
            <dl class="row mb-3">
                <dt class="col-sm-5">Fecha</dt><dd class="col-sm-7">{{ cobro.fecha|date('d/m/Y') }}</dd>
                <dt class="col-sm-5">Método de pago</dt><dd class="col-sm-7">{{ cobro.metodo|capitalize }}</dd>
                {% if cobro.referencia %}<dt class="col-sm-5">Referencia</dt><dd class="col-sm-7">{{ cobro.referencia }}</dd>{% endif %}
                {% if cobro.notas %}<dt class="col-sm-5">Notas</dt><dd class="col-sm-7">{{ cobro.notas|nl2br }}</dd>{% endif %}
                <dt class="col-sm-5">Pendiente actual del proyecto</dt><dd class="col-sm-7">{{ proyecto.pendienteCobro|number_format(2, ',', '.') }} €</dd>
            </dl>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="{{ path('proyecto_cobro_justificante_pdf', {id: cobro.id}) }}" target="_blank" rel="noopener">Imprimir justificante</a>
                <a class="btn btn-outline-secondary" href="{{ path('app_proyecto_show', {id: proyecto.id}) }}">Ver proyecto</a>
                <a class="btn btn-outline-secondary" href="{{ path('admin_pro') }}">Volver al panel</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
