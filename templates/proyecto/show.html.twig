{% extends 'base.html.twig' %}

{% block title %}Proyecto {{ proyecto.nombre }}{% endblock %}

{% block body %}
<div class="container py-4">
    {% set estadoComercialColores = {
        'borrador': 'secondary',
        'enviado': 'info',
        'aceptado': 'success',
        'rechazado': 'danger',
        'convertido': 'primary',
        'aplicado': 'warning'
    } %}
    {% set estadoCobroColores = {
        'pendiente': 'warning',
        'parcial': 'info',
        'cobrado': 'success',
        'devuelto': 'danger'
    } %}
    {% set estadoEjecucionColores = {
        'pendiente': 'warning',
        'en_curso': 'info',
        'completada': 'success',
        'pausada': 'secondary'
    } %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    {% if proyecto.rechazado %}
        <div class="alert alert-secondary" role="status"><strong>Proyecto rechazado.</strong> Todos sus presupuestos están rechazados.</div>
    {% endif %}

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">{{ proyecto.nombre }}</h1>
            {% if proyecto.obraFinalizada %}
                <div class="mb-2"><span class="badge bg-success">Obra finalizada · {{ proyecto.fechaFinReal|date('d/m/Y') }}</span></div>
            {% endif %}
            {% if proyecto.tipoObraEtiqueta %}
                <div class="mb-2"><span class="badge bg-info text-dark">{{ proyecto.tipoObraEtiqueta }}</span></div>
            {% endif %}
            <p class="text-muted mb-0">
                {% if proyecto.cliente %}
                    Cliente:
                    {{ proyecto.cliente.nombreCl }}
                    {% if proyecto.cliente.apellidosCl %}
                        {{ proyecto.cliente.apellidosCl }}
                    {% endif %}
                {% else %}
                    <span class="text-warning">Pendiente de asignar cliente</span>
                {% endif %}
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_proyecto_edit', {id: proyecto.id}) }}">Editar proyecto</a>
            {% if not proyecto.obraFinalizada and hayPresupuestoInicialAceptado %}
                <form method="post" action="{{ path('app_proyecto_finalizar', {id: proyecto.id}) }}"
                      onsubmit="return confirm('¿Has terminado esta obra? Se marcará como finalizada. Los cobros pendientes se mantienen.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('finalizar_proyecto_' ~ proyecto.id) }}">
                    <button class="btn btn-outline-success" type="submit">Finalizar obra</button>
                </form>
            {% endif %}
            {% if facturaFinal|default(null) %}
                <a class="btn btn-outline-success" href="{{ path('app_documento_show', {id: facturaFinal.id}) }}">Ver factura final</a>
            {% elseif hayPresupuestoInicialAceptado %}
                <form method="post" action="{{ path('app_proyecto_factura_final', {id: proyecto.id}) }}"
                      onsubmit="return confirm('Se emitirá la factura final con todos los presupuestos aceptados y el descuento de los anticipos. ¿Continuar?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('factura_final_' ~ proyecto.id) }}">
                    <button class="btn btn-success" type="submit">Emitir factura final</button>
                </form>
            {% endif %}
            <button type="button"
                    class="btn btn-outline-primary btnNuevoGasto"
                    data-url="{{ path('app_proyecto_gasto_new', {id: proyecto.id}) }}">
                Añadir gasto
            </button>

            <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#modalNuevoCobroProyecto">
                            + Registrar cobro
            </button>            

        </div>
    </div>

    <section class="card border-0 shadow-sm mb-3" aria-labelledby="datos-proyecto-titulo">
        <div class="card-body py-3">
            <h2 id="datos-proyecto-titulo" class="h6 mb-2">Datos del proyecto</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 gap-md-4">
                <div class="small">
                    <span class="text-muted">Inicio:</span>
                    <span>{{ proyecto.fechaInicio ? proyecto.fechaInicio|date('d/m/Y') : '—' }}</span>
                </div>

                <form method="post" action="{{ path('app_proyecto_fecha_fin_prevista', {id: proyecto.id}) }}" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="hidden" name="_token" value="{{ csrf_token('proyecto_fecha_fin_prevista_' ~ proyecto.id) }}">
                    <label for="proyecto-fecha-fin-prevista" class="small fw-semibold mb-0">Fin prevista:</label>
                    <input id="proyecto-fecha-fin-prevista" type="date" name="fecha_fin_prevista" class="form-control form-control-sm w-auto" value="{{ proyecto.fechaFinPrevista ? proyecto.fechaFinPrevista|date('Y-m-d') : '' }}" aria-describedby="fecha-fin-ayuda">
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Guardar</button>
                </form>

                <div class="small">
                    <span class="text-muted">Creado:</span>
                    <span>{{ proyecto.creadoEn ? proyecto.creadoEn|date('d/m/Y H:i') : '—' }}</span>
                </div>
            </div>
            <div id="fecha-fin-ayuda" class="small text-muted mt-1">Cambiar la fecha fin actualiza los gastos previstos y sus previsiones asociadas.</div>

            {% if proyecto.notas %}
                <div class="small mt-2"><span class="text-muted">Notas:</span> {{ proyecto.notas|nl2br }}</div>
            {% endif %}

            <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3 border-top pt-2 mt-2">
                <a href="#documentos-proyecto" class="btn btn-sm btn-outline-primary">Ver documentos</a>
                <a href="#cobros-proyecto" class="btn btn-sm btn-outline-primary">Ver cobros</a>
                <div class="small">Cobrado: <strong class="text-success">{{ proyecto.totalCobrado|number_format(2, ',', '.') }} €</strong></div>
                <div class="small">Pendiente de cobro: <strong class="{{ proyecto.pendienteCobro > 0 ? 'text-danger' : 'text-success' }}">{{ proyecto.pendienteCobro|number_format(2, ',', '.') }} €</strong></div>
            </div>
        </div>
    </section>

    {% if not proyecto.cliente %}
        <div class="alert alert-warning border-warning" role="alert">
            <h2 class="h6 alert-heading">Este proyecto todavía no tiene cliente</h2>
            <p class="mb-3">
                Se ha guardado con el nombre <strong>{{ proyecto.nombre }}</strong> para que no se pierda.
                Su presupuesto inicial ya está disponible: puedes editarlo, usar BudgetFlow y generar el PDF.
                Selecciona el cliente antes de aceptar el presupuesto.
            </p>
            <form method="post" action="{{ path('app_proyecto_asignar_cliente', {id: proyecto.id}) }}" class="row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('asignar_cliente_proyecto_' ~ proyecto.id) }}">
                <div class="col-md-8 col-lg-6">
                    <label for="cliente-proyecto-{{ proyecto.id }}" class="form-label">Cliente del proyecto</label>
                    <select id="cliente-proyecto-{{ proyecto.id }}" name="cliente_id" class="form-select" required>
                        <option value="">Selecciona un cliente para continuar</option>
                        {% for cliente in clientesDisponibles %}
                            <option value="{{ cliente.id }}">
                                {{ cliente.nombreCl }}{% if cliente.apellidosCl %} {{ cliente.apellidosCl }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary" type="submit">Asignar cliente</button>
                </div>
            </form>
        </div>
    {% endif %}


    {% set tienePresupuesto = false %}
    {% for documento in proyecto.documentos %}
        {% if documento.tipoDocumento == 'presupuesto' %}
            {% set tienePresupuesto = true %}
        {% endif %}
    {% endfor %}

    <div id="documentos-proyecto" class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <h2 class="h5 mb-0">Documentos del proyecto</h2>

            {% if hayPresupuestoInicialAceptado %}
                <form method="post"
                      action="{{ path('app_proyecto_crear_presupuesto_complementario', {id: proyecto.id}) }}">
                    <button type="submit" class="btn btn-sm btn-primary">
                        Nuevo presupuesto complementario
                    </button>
                </form>
            {% elseif not tienePresupuesto %}
                <form method="post"
                      action="{{ path('app_proyecto_crear_presupuesto_inicial', {id: proyecto.id}) }}"
                      onsubmit="return confirm('Se creará un presupuesto inicial para este proyecto. ¿Continuar?');">
                    <button type="submit" class="btn btn-sm btn-primary">
                        Crear presupuesto inicial
                    </button>
                </form>
            {% else %}
                <button class="btn btn-sm btn-outline-secondary" disabled>
                    Presupuesto inicial pendiente de aceptación
                </button>
            {% endif %}
        </div>

        <div class="card-body">
            {% if proyecto.documentos|length > 0 %}
                <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Tipo</th>
                            <th>Clasificación</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for documento in proyecto.documentos %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_documento_show', {id: documento.id}) }}"
                                       class="text-decoration-none fw-semibold">
                                        {{ documento.numero ?? ('Documento #' ~ documento.id) }}
                                    </a>
                                </td>

                                <td>
                                    {% if documento.tipoDocumento == 'presupuesto' %}
                                        <span class="badge {{ documento.id == presupuestoInicialId ? 'bg-primary' : 'bg-secondary' }}">
                                            {{ documento.id == presupuestoInicialId ? 'Inicial' : 'Complementario' }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if documento.tipoDocumento|lower == 'presupuesto' %}
                                        <span class="badge bg-primary">Presupuesto</span>
                                    {% elseif documento.tipoDocumento|lower == 'factura' %}
                                        <span class="badge bg-success">Factura</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ documento.tipoDocumento }}</span>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if documento.fechaDocumento is defined and documento.fechaDocumento %}
                                        {{ documento.fechaDocumento|date('d/m/Y') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>

                                <td>
                                    <div class="d-flex flex-column align-items-start gap-1">
                                        <span class="badge bg-{{ estadoComercialColores[documento.estadoComercial] ?? 'secondary' }}">
                                            {{ documento.estadoComercial|replace({'_': ' '})|capitalize }}
                                        </span>

                                        {% if documento.tipoDocumento in ['factura', 'ticket', 'ticket_rectificativo'] %}
                                            <span class="badge bg-{{ estadoCobroColores[documento.estadoCobro] ?? 'secondary' }}">
                                                Cobro: {{ documento.estadoCobro|replace({'_': ' '})|capitalize }}
                                            </span>
                                        {% endif %}

                                        {% if documento.tipoDocumento == 'factura' and documento.estadoEjecucion != 'no_aplica' %}
                                            <span class="badge bg-{{ estadoEjecucionColores[documento.estadoEjecucion] ?? 'secondary' }}">
                                                Obra: {{ documento.estadoEjecucion|replace({'_': ' '})|capitalize }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>

                                <td class="text-end">{{ documento.total|number_format(2, ',', '.') }} €</td>

                                <td class="text-end">
                                    <a href="{{ path('app_documento_show', {id: documento.id}) }}"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">Todavía no hay documentos asociados a este proyecto.</p>
            {% endif %}
        </div>
    </div>


    {# COBROS DEL PROYECTO #}
    <div id="cobros-proyecto" class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                        <div>
                            <h2 class="h5 mb-0">Cobros del proyecto</h2>
                            <div class="text-muted small">
                                Pagos recibidos del cliente para esta operación completa
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-primary mt-2 mt-md-0"
                                data-bs-toggle="modal"
                                data-bs-target="#modalNuevoCobroProyecto">
                            + Registrar cobro
                        </button>
                    </div>

                    <div class="row mb-3 text-center">
                        <div class="col-md-4">
                            <div class="text-muted small">Total proyecto</div>
                            <div class="fw-bold">
                                {{ proyecto.totalOperacion|format_currency('EUR', locale='es') }}
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Cobrado</div>
                            <div class="fw-bold text-success">
                                {{ proyecto.totalCobrado|format_currency('EUR', locale='es') }}
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Pendiente</div>
                            {% set pendiente = proyecto.pendienteCobro %}
                            <div class="fw-bold {{ pendiente > 0 ? 'text-danger' : 'text-success' }}">
                                {{ pendiente|format_currency('EUR', locale='es') }}
                            </div>
                        </div>
                    </div>

                    {% if proyecto.cobros is empty %}
                        <div class="border rounded p-4 bg-light-subtle">
                            <div class="fw-semibold mb-1">Sin cobros registrados</div>
                            <div class="text-muted small">
                                Registra aquí los pagos recibidos del cliente.
                            </div>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Método</th>
                                        <th class="text-end">Importe bruto</th>
                                        <th class="text-end">% Recargo</th>
                                        <th class="text-end">Recargo</th>
                                        <th class="text-end">Neto</th>
                                        <th>Referencia</th>
                                        <th>Notas</th>
                                        <th class="text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for cobro in proyecto.cobros %}
                                        <tr>
                                            <td>{{ cobro.fecha|date('d/m/Y') }}</td>
                                            <td>
                                                <span class="badge bg-secondary">
                                                    {{ cobro.metodo }}
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                {{ cobro.importeBruto|format_currency('EUR', locale='es') }}
                                            </td>
                                            <td class="text-end">
                                                {{ cobro.porcentajeRecargo }} %
                                            </td>
                                            <td class="text-end">
                                                {{ cobro.importeRecargo|format_currency('EUR', locale='es') }}
                                            </td>
                                            <td class="text-end">
                                                {{ cobro.importeNeto|format_currency('EUR', locale='es') }}
                                            </td>
                                            <td>{{ cobro.referencia ?? '—' }}</td>
                                            <td>{{ cobro.notas ?? '—' }}</td>
                                            <td class="text-end">
                                                <form method="post"
                                                    action="{{ path('proyecto_cobro_eliminar', {id: cobro.id}) }}"
                                                    onsubmit="return confirm('¿Seguro que quieres eliminar este cobro?');">
                                                    <input type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('eliminar-proyecto-cobro-' ~ cobro.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Borrar
                                                    </button>
                                                </form>
                                                <a href="{{ path('proyecto_cobro_justificante_pdf', {id: cobro.id}) }}"
                                                    target="_blank"
                                                    class="btn btn-sm btn-outline-dark">
                                                        Justificante
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalNuevoCobroProyecto" tabindex="-1" aria-labelledby="modalNuevoCobroProyectoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formNuevoCobroProyecto" method="post" action="{{ path('proyecto_cobro_nuevo', {id: proyecto.id}) }}">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalNuevoCobroProyectoLabel">Registrar cobro del proyecto</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-6">
                            <label class="form-label">Fecha</label>
                            <input type="date"
                                name="fecha"
                                class="form-control form-control-sm"
                                value="{{ "now"|date('Y-m-d') }}"
                                required>
                        </div>

                        <div class="col-6">
                            <label class="form-label">Método</label>
                            <select name="metodo" class="form-select form-select-sm" required>
                                <option value="efectivo">Efectivo</option>
                                <option value="tarjeta">Tarjeta</option>
                                <option value="transferencia">Transferencia</option>
                                <option value="bizum">Bizum</option>
                                <option value="financiacion">Financiación</option>
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="form-label">Importe bruto</label>
                            <div class="input-group input-group-sm">
                                <input type="number"
                                    name="importeBruto"
                                    class="form-control"
                                    step="0.01"
                                    min="0.01"
                                    max="{{ proyecto.pendienteCobro }}"
                                    required
                                    placeholder="{{ proyecto.pendienteCobro|number_format(2, '.', '') }}">
                                <span class="input-group-text">€</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label">% Recargo</label>
                            <div class="input-group input-group-sm">
                                <input type="number"
                                    name="porcentajeRecargo"
                                    class="form-control"
                                    step="0.01"
                                    min="0"
                                    value="0">
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <input type="hidden" name="importeRecargo" value="0">
                        <input type="hidden" name="importeNeto" value="0">

                        <div class="col-12">
                            <label class="form-label">Referencia</label>
                            <input type="text"
                                name="referencia"
                                class="form-control form-control-sm"
                                placeholder="Transferencia, VISA *1234, financiación...">
                        </div>

                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea name="notas"
                                    class="form-control form-control-sm"
                                    rows="2"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-sm btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-sm btn-primary">
                            Guardar cobro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>    

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Resumen económico de la obra</h2>
            <div class="small text-muted">Importes sin IVA. El margen estimado combina costes confirmados y previsiones aún pendientes.</div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Ingresos sin IVA</div><div class="fw-bold">{{ economico.ingresoSinIva|number_format(2, ',', '.') }} €</div></div>
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Coste confirmado</div><div class="fw-bold">{{ economico.costeConfirmado|number_format(2, ',', '.') }} €</div></div>
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Pendiente de confirmar</div><div class="fw-bold text-warning">{{ economico.costePrevistoPendiente|number_format(2, ',', '.') }} €</div></div>
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Coste total estimado</div><div class="fw-bold">{{ economico.costeTotalEstimado|number_format(2, ',', '.') }} €</div></div>
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Margen estimado</div><div class="fw-bold {{ economico.margenEstimado >= 0 ? 'text-success' : 'text-danger' }}">{{ economico.margenEstimado|number_format(2, ',', '.') }} €</div></div>
                <div class="col-md-4 col-xl-2"><div class="small text-muted">Margen sobre ventas</div><div class="fw-bold {{ economico.margenSobreVentas >= 0 ? 'text-success' : 'text-danger' }}">{{ economico.margenSobreVentas|number_format(1, ',', '.') }} %</div></div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total presupuestado</div>
                    <div class="fs-5 fw-bold">{{ proyecto.totalPresupuestado|number_format(2, ',', '.') }} €</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total facturado</div>
                    <div class="fs-5 fw-bold">{{ proyecto.totalFacturado|number_format(2, ',', '.') }} €</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total cobrado</div>
                    <div class="fs-5 fw-bold">{{ proyecto.totalCobrado|number_format(2, ',', '.') }} €</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Pendiente</div>
                    <div class="fs-5 fw-bold">
                        {{ proyecto.pendienteCobro|number_format(2, ',', '.') }} €
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# GASTOS DEL PROYECTO #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
            <span>Gastos del proyecto</span>
                <button type="button"
                        class="btn btn-sm btn-outline-primary btnNuevoGasto" 
                        data-url="{{ path('app_proyecto_gasto_new', {id: proyecto.id}) }}">
                    Añadir gasto
                </button>
        </div>

        <div class="card-body">
            {% if proyecto.gastos is defined and proyecto.gastos|length > 0 %}
        <div class="table-responsive">
            <table class="table align-middle mb-0 tabla-gastos">
                <thead>
                    <tr>
                        <th>Fecha prevista</th>
                        <th>Estado</th>
                        <th>Categoría</th>
                        <th>Concepto</th>
                        <th>Proveedor</th>
                        <th class="text-end">Previsto</th>
                        <th class="text-end">Real</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {% for gasto in proyecto.gastos %}
                        <tr>
                            <td class="gasto-fecha">
                                {{ gasto.fechaPrevista ? gasto.fechaPrevista|date('d/m/Y') : '—' }}
                            </td>

                            <td class="gasto-estado">
                                {% if gasto.estado == 'previsto' %}
                                    <span class="badge bg-secondary">Previsto</span>
                                {% elseif gasto.estado == 'confirmado' %}
                                    <span class="badge bg-success">Confirmado</span>
                                {% elseif gasto.estado == 'pagado' %}
                                    <span class="badge bg-success">Pagado</span>
                                {% elseif gasto.estado == 'cancelado' %}
                                    <span class="badge bg-dark">Cancelado</span>
                                {% else %}
                                    <span class="badge bg-light text-dark">{{ gasto.estado }}</span>
                                {% endif %}
                            </td>
                            <td class="gasto-categoria">
                                    {{ gasto.categoria ?: '—' }}
                                </td>

                                <td class="gasto-concepto"
                                    title="{{ gasto.concepto }}">
                                    {{ gasto.concepto }}
                                </td>

                                <td class="gasto-proveedor"
                                    title="{{ gasto.proveedor ?: '' }}">
                                    {{ gasto.proveedor ?: '—' }}
                                </td>

                                <td class="gasto-importe text-end">
                                    {{ gasto.importePrevisto|number_format(2, ',', '.') }}&nbsp;€
                                </td>

                                <td class="gasto-importe text-end">
                                    {% if gasto.importeReal is not null %}
                                        {{ gasto.importeReal|number_format(2, ',', '.') }}&nbsp;€
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>

                                <td class="gasto-acciones text-end">
                                    <div class="btn-group btn-group-sm">



                                        {% if gasto.estado == 'previsto' %}

                                            <button type="button"
                                                    class="btn btn-outline-primary btnEditarGasto"
                                                    data-url="{{ path('app_proyecto_gasto_edit', {id: gasto.id}) }}"
                                                    title="Editar gasto">
                                                <i class="bi bi-pencil"></i>
                                            </button>                                  



                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_confirmar', {id: gasto.id}) }}">
                                                <button class="btn btn-outline-info"
                                                        title="Confirmar">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>

                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_delete', {id: gasto.id}) }}"
                                                onsubmit="return confirm('¿Eliminar gasto?');">
                                                <button class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                        {% elseif gasto.estado == 'confirmado' and gasto.origen == 'factura_proveedor' %}
                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_cancelar', {id: gasto.id}) }}">
                                                <button class="btn btn-outline-dark"
                                                        title="Cancelar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        {% elseif gasto.estado == 'confirmado' and gasto.origen != 'factura_proveedor' %}

                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_pagado', {id: gasto.id}) }}">                    
                                                <button type="button"
                                                        class="btn btn-outline-success btnMarcarGastoPagado"
                                                        data-url="{{ path('app_proyecto_gasto_pagado', {id: gasto.id}) }}"
                                                        data-concepto="{{ gasto.concepto|e('html_attr') }}"
                                                        data-importe="{{ gasto.importeReal ?? gasto.importePrevisto }}"
                                                        title="Marcar pagado">
                                                    <i class="bi bi-cash"></i>
                                                </button>
                                            </form> 

                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_cancelar', {id: gasto.id}) }}">
                                                <button class="btn btn-outline-dark"
                                                        title="Cancelar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>

                                        {% elseif gasto.estado == 'pagado' %}

                                            {% if gasto.bancoMovimiento %}
                                                <a href="{{ path('admin_banco_movimiento_show', {id: gasto.bancoMovimiento.id}) }}"
                                                class="btn btn-outline-secondary"
                                                title="Ver movimiento">
                                                    <i class="bi bi-bank"></i>
                                                </a>
                                            {% endif %}

                                        {% elseif gasto.estado == 'cancelado' %}

                                            <form method="post"
                                                action="{{ path('app_proyecto_gasto_reactivar', {id: gasto.id}) }}">
                                                <button class="btn btn-outline-warning">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </form>

                                        {% endif %}

                                    </div>
                                </td>                                    
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">Todavía no hay gastos asociados a este proyecto.</p>
            {% endif %}
        </div>
    </div>
</div>

{# MODAL NUEVO GASTO #}
<div class="modal fade" id="modalProyectoGasto" tabindex="-1" aria-labelledby="modalProyectoGastoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalProyectoGastoLabel">Nuevo gasto del proyecto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalProyectoGastoBody">
                <div class="text-muted">Cargando formulario...</div>
            </div>
        </div>
    </div>
</div>

{# MODAL GASTO PAGADO #}

<div class="modal fade" id="modalGastoPagado" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Marcar gasto como pagado</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <div class="text-muted small">Gasto</div>
                    <div class="fw-semibold" id="gastoPagadoConcepto"></div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Importe</div>
                    <div class="fw-semibold" id="gastoPagadoImporte"></div>
                </div>

                <div class="alert alert-light border">
                    ¿Cómo se ha realizado el pago?
                </div>

                <div class="d-grid gap-2">

                    <button type="button"
                            class="btn btn-outline-success"
                            id="btnGastoPagoEfectivo">
                        <i class="bi bi-cash me-1"></i>
                        Efectivo
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            id="btnGastoPagoBanco">
                        <i class="bi bi-bank me-1"></i>
                        Banco / tarjeta / transferencia / Bizum
                    </button>

                </div>

            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block jscustom %}

    {{ parent() }}

    <script src="{{ asset('assets/js/proyecto/proyecto-gasto.js') }}"></script>
    <script src="{{ asset('assets/js/proyecto/proyecto-cobro.js') }}"></script>


{% endblock %}
