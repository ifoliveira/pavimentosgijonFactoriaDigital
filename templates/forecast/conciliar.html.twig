{% extends 'base.html.twig' %}

{% block title %}Conciliación bancaria{% endblock %}
{% block cabecera %}Conciliación bancaria{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Conciliación bancaria</li>
{% endblock %}

{% block body %}

<div class="container-fluid py-3">

    {# ============================================================
       RESUMEN
       ============================================================ #}
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Movimientos banco pendientes
                    </div>

                    <div class="fs-3 fw-bold">
                        {{ bancos|length }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="text-muted small">
                                Forecast pendientes
                            </div>

                            <div class="fs-3 fw-bold">
                                {{ totalForecastPendientes ?? '—' }}
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="text-muted small">
                                Cobros pendientes
                            </div>

                            <div class="fs-3 fw-bold">
                                {{ totalCobrosPendientes ?? '—' }}
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Modo
                    </div>

                    <div class="fw-semibold mt-2">
                        Conciliación bancaria
                    </div>

                    <div class="small text-muted">
                        Pagos → Forecast · Ingresos → Cobros
                    </div>
                </div>
            </div>
        </div>

    </div>


    {# ============================================================
       CONCILIADOR
       ============================================================ #}
    <div class="row g-4">

        {# ========================================================
           BANCO
           ======================================================== #}
        <div class="col-xl-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">
                                Movimientos bancarios
                            </h4>

                            <div class="small text-muted">
                                Pendientes de conciliación
                            </div>
                        </div>

                        <span class="badge bg-light text-dark">
                            {{ bancos|length }}
                        </span>
                    </div>
                </div>

                <div class="card-body p-0">

                    {# BUSCADOR #}
                    <div class="p-3 border-bottom">
                        <input type="text"
                               id="buscarBanco"
                               class="form-control"
                               placeholder="Buscar concepto, importe o fecha...">
                    </div>


                    {# LISTA BANCO #}
                    <div id="listaBanco"
                         style="max-height: 650px; overflow-y:auto;">

                        {% if bancos is empty %}

                            <div class="p-5 text-center text-muted">
                                No hay movimientos pendientes de conciliación.
                            </div>

                        {% else %}

                            {% for banco in bancos %}

                                <button type="button"
                                        class="w-100 border-0 border-bottom bg-white text-start p-3 movimiento-banco"
                                        data-id="{{ banco.id }}"
                                        data-importe="{{ banco.importeBn }}"
                                        data-fecha="{{ banco.fechaBn|date('Y-m-d') }}"
                                        data-concepto="{{ banco.conceptoBn|e('html_attr') }}">

                                    <div class="d-flex justify-content-between gap-3">

                                        <div class="flex-grow-1">

                                            <div class="fw-semibold banco-concepto">
                                                {{ banco.conceptoBn ?: 'Movimiento bancario' }}
                                            </div>

                                            <div class="small text-muted mt-1">
                                                {{ banco.fechaBn|date('d/m/Y') }}
                                            </div>

                                        </div>

                                        <div class="text-end">

                                            <div class="fs-5 fw-bold
                                                {{ banco.importeBn < 0
                                                    ? 'text-danger'
                                                    : 'text-success' }}">
                                                {{ banco.importeBn|format_currency('EUR', locale='es') }}
                                            </div>

                                            <div class="small text-muted">
                                                #{{ banco.id }}
                                            </div>

                                        </div>

                                    </div>

                                </button>

                            {% endfor %}

                        {% endif %}

                    </div>

                </div>
            </div>

        </div>


        {# ========================================================
           CANDIDATOS
           ======================================================== #}
        <div class="col-xl-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-bottom">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h4 class="mb-1" id="tituloCandidatos">
                                Coincidencias
                            </h4>

                            <div class="small text-muted"
                                id="subtituloCandidatos">
                                Selecciona un movimiento bancario
                            </div>
                        </div>

                        <span id="badgeCandidatos"
                              class="badge bg-light text-dark"
                              style="display:none;">
                            0
                        </span>

                    </div>

                </div>


                <div class="card-body">

                    {# =================================================
                       MOVIMIENTO SELECCIONADO
                       ================================================= #}
                    <div id="sinBancoSeleccionado"
                         class="text-center text-muted py-5">

                        <div class="fs-1 mb-3">
                            <i class="bi bi-bank"></i>
                        </div>

                        <h5>Selecciona un movimiento bancario</h5>

                        <div class="small">
                            Los pagos buscarán Forecast y los ingresos buscarán cobros.
                        </div>

                    </div>


                    <div id="panelBancoSeleccionado"
                         style="display:none;">

                        <div class="border rounded p-3 mb-4 bg-light">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div>
                                    <div class="text-muted small mb-1">
                                        Movimiento seleccionado
                                    </div>

                                    <div id="bancoSeleccionadoConcepto"
                                         class="fw-semibold fs-5">
                                    </div>

                                    <div id="bancoSeleccionadoFecha"
                                         class="small text-muted mt-1">
                                    </div>
                                </div>

                                <div id="bancoSeleccionadoImporte"
                                     class="fw-bold fs-4">
                                </div>

                            </div>

                        </div>


                        {# =================================================
                           LOADING
                           ================================================= #}
                        <div id="cargandoCandidatos"
                             class="text-center py-5"
                             style="display:none;">

                            <div class="spinner-border spinner-border-sm me-2"
                                 role="status">
                            </div>

                            Buscando coincidencias...

                        </div>


                        {# =================================================
                           LISTA CANDIDATOS
                           ================================================= #}
                        <div id="contenedorCandidatos"></div>


                        {# =================================================
                           SIN CANDIDATOS
                           ================================================= #}
                        <div id="sinCandidatos"
                             class="border rounded p-4 text-center"
                             style="display:none;">

                            <div class="fw-semibold mb-1">
                                No hemos encontrado coincidencias claras
                            </div>

                            <div class="small text-muted mb-3">
                                Puedes buscar manualmente entre los Forecast pendientes.
                            </div>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    id="btnBuscarManual">
                                Buscar manualmente
                            </button>

                        </div>


                        {# =================================================
                           BÚSQUEDA MANUAL
                           ================================================= #}
                        <div id="panelBusquedaManual"
                             class="mt-4"
                             style="display:none;">

                            <hr>

                            <h5 class="mb-3">
                                Búsqueda manual
                            </h5>

                            <div class="input-group mb-3">

                                <input type="text"
                                       id="buscarForecastManual"
                                       class="form-control"
                                       placeholder="Concepto, importe, proveedor...">

                                <button type="button"
                                        class="btn btn-outline-primary"
                                        id="btnEjecutarBusquedaManual">
                                    Buscar
                                </button>

                            </div>

                            <div id="resultadosBusquedaManual"></div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


{# ================================================================
   MODAL CONFIRMACIÓN
   ================================================================ #}
<div class="modal fade"
     id="modalConfirmarConciliacion"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Confirmar conciliación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p class="mb-3">
                    Se asociará:
                </p>

                <div class="border rounded p-3 mb-3">

                    <div class="text-muted small">
                        Banco
                    </div>

                    <div id="modalBanco"
                         class="fw-semibold">
                    </div>

                </div>

                <div class="text-center mb-3">
                    <i class="bi bi-link-45deg fs-3"></i>
                </div>

                <div class="border rounded p-3">

                    <div class="text-muted small"
                        id="modalTipoCandidato">
                        Candidato
                    </div>

                    <div id="modalCandidato"
                        class="fw-semibold">
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-success"
                        id="btnConfirmarConciliacion">
                    Conciliar
                </button>

            </div>

        </div>

    </div>

</div>

{% endblock %}


{% block jscustom %}

<script>
document.addEventListener('DOMContentLoaded', function () {

    let bancoSeleccionado = null;
    let candidatoSeleccionado = null;
    let tipoConciliacion = null;

    const movimientosBanco =
        document.querySelectorAll('.movimiento-banco');

    const sinBancoSeleccionado =
        document.getElementById('sinBancoSeleccionado');

    const panelBancoSeleccionado =
        document.getElementById('panelBancoSeleccionado');

    const cargandoCandidatos =
        document.getElementById('cargandoCandidatos');

    const contenedorCandidatos =
        document.getElementById('contenedorCandidatos');

    const sinCandidatos =
        document.getElementById('sinCandidatos');

    const badgeCandidatos =
        document.getElementById('badgeCandidatos');


    /*
     * ============================================================
     * SELECCIÓN DE MOVIMIENTO BANCO
     * ============================================================
     */
    movimientosBanco.forEach(function (elemento) {

        elemento.addEventListener('click', function () {

            movimientosBanco.forEach(function (item) {
                item.classList.remove('bg-light');
            });

            this.classList.add('bg-light');

            bancoSeleccionado = {
                id: this.dataset.id,
                importe: parseFloat(this.dataset.importe),
                fecha: this.dataset.fecha,
                concepto: this.dataset.concepto
            };

            candidatoSeleccionado = null;

            tipoConciliacion =
                bancoSeleccionado.importe < 0
                    ? 'forecast'
                    : 'cobro';

            actualizarTipoConciliacion();

            mostrarBancoSeleccionado();

            cargarCandidatos();
        });

    });


    function actualizarTipoConciliacion() {

        const titulo =
            document.getElementById('tituloCandidatos');

        const subtitulo =
            document.getElementById('subtituloCandidatos');

        if (tipoConciliacion === 'forecast') {

            titulo.textContent = 'Forecast candidatos';

            subtitulo.textContent =
                'Previsiones de pago que pueden corresponder con este movimiento.';

        } else {

            titulo.textContent = 'Cobros candidatos';

            subtitulo.textContent =
                'Cobros de proyectos que pueden corresponder con este ingreso.';
        }
    }


    /*
     * ============================================================
     * MOSTRAR BANCO SELECCIONADO
     * ============================================================
     */
    function mostrarBancoSeleccionado() {

        sinBancoSeleccionado.style.display = 'none';
        panelBancoSeleccionado.style.display = 'block';

        document.getElementById(
            'bancoSeleccionadoConcepto'
        ).textContent = bancoSeleccionado.concepto;

        document.getElementById(
            'bancoSeleccionadoFecha'
        ).textContent = formatearFecha(
            bancoSeleccionado.fecha
        );

        const importeEl =
            document.getElementById(
                'bancoSeleccionadoImporte'
            );

        importeEl.textContent =
            formatearImporte(
                bancoSeleccionado.importe
            );

        importeEl.className =
            'fw-bold fs-4 ' +
            (
                bancoSeleccionado.importe < 0
                    ? 'text-danger'
                    : 'text-success'
            );
    }


    /*
     * ============================================================
     * CARGAR CANDIDATOS
     * ============================================================
     */
    async function cargarCandidatos() {

        if (!bancoSeleccionado) {
            return;
        }

        candidatoSeleccionado = null;

        contenedorCandidatos.innerHTML = '';

        sinCandidatos.style.display = 'none';
        cargandoCandidatos.style.display = 'block';
        badgeCandidatos.style.display = 'none';

        try {

            let url;

            if (tipoConciliacion === 'forecast') {

                url =
                    `/admin/forecast/conciliacion/candidatos/${bancoSeleccionado.id}`;

            } else {

                url =
                    `/admin/forecast/conciliacion/cobros/candidatos/${bancoSeleccionado.id}`;
            }

            console.log('TIPO:', tipoConciliacion);
            console.log('BANCO:', bancoSeleccionado);
            console.log('URL CANDIDATOS:', url);

            const response = await fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const contentType =
                response.headers.get('content-type') || '';

            if (!contentType.includes('application/json')) {

                const texto = await response.text();

                console.error(
                    'Respuesta no JSON:',
                    response.status,
                    texto
                );

                throw new Error(
                    'El servidor no devolvió una respuesta JSON.'
                );
            }

            const data = await response.json();

            cargandoCandidatos.style.display = 'none';

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message ||
                    'No se pudieron obtener candidatos.'
                );
            }

            const candidatos = data.candidatos || [];

            badgeCandidatos.textContent =
                candidatos.length;

            badgeCandidatos.style.display =
                'inline-block';

            if (candidatos.length === 0) {
                sinCandidatos.style.display = 'block';
                return;
            }

            candidatos.forEach(function (candidato) {
                pintarCandidato(candidato);
            });

        } catch (error) {

            console.error(
                'Error cargando candidatos:',
                error
            );

            cargandoCandidatos.style.display = 'none';

            contenedorCandidatos.innerHTML = `
                <div class="alert alert-danger">
                    ${escaparHtml(error.message)}
                </div>
            `;
        }
    }


    /*
     * ============================================================
     * PINTAR CANDIDATO
     * ============================================================
     */
    function pintarCandidato(candidato) {

        const wrapper = document.createElement('div');

        wrapper.className =
            'border rounded p-3 mb-3 candidato-conciliacion';

        let badge = '';

        if (candidato.score >= 90) {

            badge = `
                <span class="badge bg-success">
                    Coincidencia alta
                </span>
            `;

        } else if (candidato.score >= 70) {

            badge = `
                <span class="badge bg-warning text-dark">
                    Coincidencia media
                </span>
            `;

        } else {

            badge = `
                <span class="badge bg-secondary">
                    Coincidencia posible
                </span>
            `;
        }

        wrapper.innerHTML = `

            <div class="d-flex justify-content-between gap-3">

                <div class="flex-grow-1">

                    <div class="d-flex align-items-center gap-2 mb-1">

                        <div class="fw-semibold">
                            ${escaparHtml(candidato.concepto)}
                        </div>

                        ${badge}

                    </div>

                    <div class="small text-muted">

                        Previsto:
                        ${tipoConciliacion === 'forecast' ? 'Previsto' : 'Cobro'}:
                        ${formatearFecha(candidato.fecha)}

                        ·

                        Diferencia:
                        ${candidato.diferenciaDias} días
                        .

                        ${tipoConciliacion === 'cobro' && candidato.metodo
                            ? `
                                <span class="badge bg-light text-dark ms-2">
                                    ${escaparHtml(candidato.metodo)}
                                </span>
                            `
                            : ''
                        }                        

                    </div>

                    ${
                        candidato.motivo
                            ? `
                                <div class="small mt-2">
                                    ${escaparHtml(candidato.motivo)}
                                </div>
                            `
                            : ''
                    }

                </div>

                <div class="text-end">

                    <div class="fw-bold fs-5">
                        ${formatearImporte(
                            parseFloat(candidato.importe)
                        )}
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-outline-success mt-2 btnSeleccionarCandidato"
                        Conciliar
                    </button>

                </div>

            </div>
        `;

        wrapper.querySelector(
            '.btnSeleccionarCandidato'
        ).addEventListener('click', function () {

            candidatoSeleccionado = candidato;

            abrirConfirmacion();
        });

        contenedorCandidatos.appendChild(wrapper);
    }


    /*
     * ============================================================
     * CONFIRMACIÓN
     * ============================================================
     */
    function abrirConfirmacion() {

    document.getElementById('modalBanco').textContent =
        bancoSeleccionado.concepto +
        ' · ' +
        formatearImporte(bancoSeleccionado.importe);

    document.getElementById(
        'modalTipoCandidato'
    ).textContent =
        tipoConciliacion === 'forecast'
            ? 'Forecast'
            : 'Cobro de proyecto';

    document.getElementById(
        'modalCandidato'
    ).textContent =
        candidatoSeleccionado.concepto +
        ' · ' +
        formatearImporte(
            parseFloat(candidatoSeleccionado.importe)
        );

    const modalEl =
        document.getElementById(
            'modalConfirmarConciliacion'
        );

    let modal =
        bootstrap.Modal.getInstance(modalEl);

    if (!modal) {
        modal = new bootstrap.Modal(modalEl);
    }

    modal.show();
    }


    /*
     * ============================================================
     * CONFIRMAR CONCILIACIÓN
     * ============================================================
     */
    document.getElementById(
        'btnConfirmarConciliacion'
    ).addEventListener('click', async function () {

        if (!bancoSeleccionado || !candidatoSeleccionado) {
            return;
        }

        const boton = this;
        boton.disabled = true;

        try {

            let url;

            if (tipoConciliacion === 'forecast') {

                url =
                    `/admin/forecast/${candidatoSeleccionado.id}/conciliar`;

            } else {

                url =
                    `/admin/forecast/conciliacion/cobro/${candidatoSeleccionado.id}`;
            }

            const formData = new FormData();

            formData.append(
                'banco',
                bancoSeleccionado.id
            );

            console.log('TIPO CONCILIACION:', tipoConciliacion);
            console.log('URL CONCILIAR:', url);
            console.log('BANCO:', bancoSeleccionado.id);
            console.log('CANDIDATO:', candidatoSeleccionado.id);

            const response = await fetch(
                url,
                {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }
            );

            const data = await response.json();

            if (!data.success) {
                throw new Error(
                    data.message || 'No se pudo conciliar.'
                );
            }

            window.location.reload();

        } catch (error) {

            console.error(
                'Error conciliando:',
                error
            );

            alert(
                error.message ||
                'No se pudo realizar la conciliación.'
            );

        } finally {

            boton.disabled = false;
        }
    });


    /*
     * ============================================================
     * BUSCADOR BANCO
     * ============================================================
     */
    document.getElementById(
        'buscarBanco'
    )?.addEventListener('input', function () {

        const texto =
            this.value.toLowerCase().trim();

        movimientosBanco.forEach(function (elemento) {

            const contenido =
                elemento.textContent.toLowerCase();

            elemento.style.display =
                contenido.includes(texto)
                    ? ''
                    : 'none';
        });
    });


    /*
     * ============================================================
     * BÚSQUEDA MANUAL
     * ============================================================
     */
    document.getElementById(
        'btnBuscarManual'
    )?.addEventListener('click', function () {

        document.getElementById(
            'panelBusquedaManual'
        ).style.display = 'block';
    });


    document.getElementById(
        'btnEjecutarBusquedaManual'
    )?.addEventListener('click', async function () {

        const texto = document.getElementById(
            'buscarForecastManual'
        ).value.trim();

        const contenedor = document.getElementById(
            'resultadosBusquedaManual'
        );

        if (!texto) {
            contenedor.innerHTML = `
                <div class="text-muted small">
                    Introduce un concepto o importe.
                </div>
            `;
            return;
        }

        contenedor.innerHTML = `
            <div class="text-muted">
                Buscando...
            </div>
        `;

        try {

            const url = "{{ path('forecast_conciliacion_buscar') }}"
                + '?q='
                + encodeURIComponent(texto);

            const response = await fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json();

            if (!data.success) {
                throw new Error(
                    data.message || 'Error realizando la búsqueda.'
                );
            }

            contenedor.innerHTML = '';

            if (!data.resultados.length) {

                contenedor.innerHTML = `
                    <div class="alert alert-light border">
                        No se encontraron Forecast pendientes.
                    </div>
                `;

                return;
            }

            data.resultados.forEach(function (forecast) {

                const fila = document.createElement('div');

                fila.className =
                    'border rounded p-3 mb-2 d-flex justify-content-between align-items-center';

                fila.innerHTML = `
                    <div>
                        <div class="fw-semibold">
                            ${escaparHtml(forecast.concepto)}
                        </div>

                        <div class="small text-muted">
                            ${formatearFecha(forecast.fecha)}
                        </div>
                    </div>

                    <div class="text-end">
                        <div class="fw-bold mb-2">
                            ${formatearImporte(forecast.importe)}
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-success">
                            Conciliar
                        </button>
                    </div>
                `;

                fila.querySelector('button')
                    .addEventListener('click', function () {

                        forecastSeleccionado = forecast;

                        abrirConfirmacion();
                    });

                contenedor.appendChild(fila);
            });

        } catch (error) {

            console.error(error);

            contenedor.innerHTML = `
                <div class="alert alert-danger">
                    No se pudo realizar la búsqueda.
                </div>
            `;
        }
    });


    /*
     * ============================================================
     * FORMATOS
     * ============================================================
     */
    function formatearImporte(valor) {

        return Number(valor).toLocaleString(
            'es-ES',
            {
                style: 'currency',
                currency: 'EUR'
            }
        );
    }


    function formatearFecha(fecha) {

        if (!fecha) {
            return '—';
        }

        const partes = fecha.split('-');

        if (partes.length !== 3) {
            return fecha;
        }

        return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }


    function escaparHtml(texto) {

        const div = document.createElement('div');
        div.textContent = texto ?? '';

        return div.innerHTML;
    }

});
</script>

