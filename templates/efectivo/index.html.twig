{% extends 'base.html.twig' %}
{% block title %}Caja · Efectivo{% endblock %}
{% block cabecera %}Caja · Efectivo{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Caja</li>{% endblock %}
{% block body %}
{% for mensaje in app.flashes('success') %}<div class="alert alert-success" role="status">{{ mensaje }}</div>{% endfor %}
{% if error %}<div class="alert alert-danger" role="alert">No se ha guardado: {{ error }}</div>{% endif %}
<div class="card bg-dark text-white"><div class="card-body d-flex flex-wrap align-items-center justify-content-between">
    <div><div>Saldo esperado en caja</div><div class="display-4 font-weight-bold">{{ (saldoCentimos / 100)|number_format(2, ',', '.') }} €</div>
        <small>Movimientos desde el 01/01/2024 hasta hoy. Comprueba el efectivo real con un recuento.</small></div>
    <a href="#salida-caja" class="btn btn-warning btn-lg my-3">Sacar dinero de caja</a>
</div></div>
<div class="row">
    <div class="col-lg-7"><div class="card" id="salida-caja"><div class="card-body">
        <h4 class="card-title">Sacar dinero de caja</h4>
        <p class="text-muted">Apunta la salida en el momento de sacar el dinero. Solo necesitas dos datos.</p>
        <form method="post" action="{{ path('efectivo_index') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('caja') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="accion" value="salida">
            <div class="form-group"><label for="salida-importe">Cuánto sale (€)</label>
                <input class="form-control form-control-lg" id="salida-importe" name="importe" inputmode="decimal" placeholder="45,00" required maxlength="10" value="{{ datos.accion|default('') == 'salida' and datos.importe|default('') is not iterable ? datos.importe|default('') : '' }}"></div>
            <div class="form-group"><label for="salida-concepto">Motivo de la salida</label>
                <select class="form-control form-control-lg" id="salida-concepto" name="concepto" required>
                    <option value="">Selecciona un motivo</option>
                    {% for motivo in motivosSalida %}
                        <option value="{{ motivo }}"{{ datos.accion|default('') == 'salida' and datos.concepto|default('') == motivo ? ' selected' : '' }}>{{ motivo }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="caja-salida-acciones">
                <button class="btn btn-warning btn-lg" type="submit">Registrar salida</button>
            </div>
        </form>
        <p class="text-muted mt-3 mb-0"><i class="mdi mdi-information-outline" aria-hidden="true"></i> Los pagos registrados desde caja en un proyecto ya se descuentan automáticamente. No los apuntes otra vez aquí.</p>
    </div></div></div>
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h4 class="card-title">Cuadrar caja</h4><p class="text-muted">Cuenta los billetes y monedas e indica el total.</p>
        <form method="post" action="{{ path('efectivo_index') }}" id="recuento-caja" data-saldo="{{ saldoCentimos }}">
            <input type="hidden" name="_token" value="{{ csrf_token('caja') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="accion" value="recuento"><input type="hidden" name="saldo" value="{{ saldoCentimos }}">
            <div class="form-group"><label for="contado">Cuánto hay realmente (€)</label><input class="form-control form-control-lg" id="contado" name="contado" inputmode="decimal" placeholder="0,00" required maxlength="10" value="{{ datos.accion|default('') == 'recuento' and datos.contado|default('') is not iterable ? datos.contado|default('') : '' }}"></div>
            <p id="resultado-recuento" class="font-weight-bold" aria-live="polite">Esperado: {{ (saldoCentimos / 100)|number_format(2, ',', '.') }} €</p>
            <button class="btn btn-primary" type="submit">Guardar recuento</button>
        </form><small class="text-muted d-block mt-3">El recuento guarda la diferencia. No cambia el saldo ni inventa una entrada o salida.</small>
    </div></div></div>
</div>
<details class="card"><summary class="card-body font-weight-bold">Añadir una entrada de efectivo</summary><div class="card-body pt-0">
    <p class="text-muted">Para aportaciones a caja que no estén registradas como cobro.</p>
    <form method="post" action="{{ path('efectivo_index') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('caja') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="accion" value="entrada">
        <div class="row"><div class="col-md-3 form-group"><label for="entrada-importe">Cuánto entra (€)</label><input class="form-control" id="entrada-importe" name="importe" inputmode="decimal" required maxlength="10" value="{{ datos.accion|default('') == 'entrada' and datos.importe|default('') is not iterable ? datos.importe|default('') : '' }}"></div>
        <div class="col-md-9 form-group"><label for="entrada-concepto">Motivo de la entrada</label><input class="form-control" id="entrada-concepto" name="concepto" required maxlength="255" value="{{ datos.accion|default('') == 'entrada' and datos.concepto|default('') is not iterable ? datos.concepto|default('') : '' }}"></div></div>
        <button class="btn btn-success" type="submit">Registrar entrada</button>
    </form>
</div></details>
<div class="card"><div class="card-body"><h4 class="card-title">Últimos movimientos</h4><p class="text-muted">Hasta 300 movimientos, del más reciente al más antiguo. El saldo incluye todos los movimientos del periodo indicado.</p>
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Movimiento</th><th>Para qué / para quién</th><th>Registrado por</th><th class="text-right">Importe</th></tr></thead><tbody>
    {% for movimiento in efectivos %}<tr>
        <td class="text-nowrap">{{ movimiento.fechaEf|date('d/m/Y') }}</td>
        <td><span class="badge {{ movimiento.importeEf < 0 ? 'badge-warning' : 'badge-success' }}">{{ movimiento.importeEf < 0 ? 'Salida' : 'Entrada' }}</span></td>
        <td>{{ movimiento.conceptoEf }}{% if movimiento.tipoEf %}<small class="d-block text-muted">{{ movimiento.tipoEf }}</small>{% endif %}</td>
        <td>{{ movimiento.registradoPor ?? 'Sin registrar' }}</td>
        <td class="text-right text-nowrap font-weight-bold {{ movimiento.importeEf < 0 ? 'text-danger' : 'text-success' }}">{{ movimiento.importeEf > 0 ? '+' : '' }}{{ movimiento.importeEf|number_format(2, ',', '.') }} €</td>
    </tr>{% else %}<tr><td colspan="5">Todavía no hay movimientos de caja.</td></tr>{% endfor %}
    </tbody></table></div>
</div></div>
<div class="card"><div class="card-body"><h4 class="card-title">Últimos recuentos</h4>
    <div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Esperado</th><th>Contado</th><th>Cuadre</th><th>Registrado por</th></tr></thead><tbody>
    {% for recuento in recuentos %}<tr><td class="text-nowrap">{{ recuento.fecha|date('d/m/Y H:i') }}</td><td>{{ (recuento.esperadoCentimos / 100)|number_format(2, ',', '.') }} €</td><td>{{ (recuento.contadoCentimos / 100)|number_format(2, ',', '.') }} €</td><td class="{{ recuento.diferenciaCentimos == 0 ? 'text-success' : 'text-danger' }}">{% if recuento.diferenciaCentimos == 0 %}Cuadra{% else %}{{ recuento.diferenciaCentimos < 0 ? 'Faltan' : 'Sobran' }} {{ (recuento.diferenciaCentimos|abs / 100)|number_format(2, ',', '.') }} €{% endif %}</td><td>{{ recuento.registradoPor }}</td></tr>
    {% else %}<tr><td colspan="5">Aún no se ha contado la caja. Guarda el primer recuento para comprobarla.</td></tr>{% endfor %}
    </tbody></table></div>
</div></div>
{% endblock %}
{% block jscustom %}
<script>
(function () {
    const form = document.getElementById('recuento-caja');
    const input = document.getElementById('contado');
    const output = document.getElementById('resultado-recuento');
    const euros = new Intl.NumberFormat('es-ES', {style: 'currency', currency: 'EUR'});
    function actualizar() {
        const valor = input.value.trim();
        if (!/^\d{1,7}(?:[.,]\d{1,2})?$/.test(valor)) {
            output.textContent = 'Esperado: ' + euros.format(Number(form.dataset.saldo) / 100);
            return;
        }
        const diferencia = Math.round(Number(valor.replace(',', '.')) * 100) - Number(form.dataset.saldo);
        output.textContent = diferencia === 0 ? 'La caja cuadra.' : (diferencia < 0 ? 'Faltan ' : 'Sobran ') + euros.format(Math.abs(diferencia) / 100);
    }
    input.addEventListener('input', actualizar);
    actualizar();
    document.querySelectorAll('form[method="post"]').forEach(function (formulario) {
        formulario.addEventListener('submit', function () {
            formulario.querySelector('button[type="submit"]').disabled = true;
        });
    });
})();
</script>
{% endblock %}
