{% extends 'base.html.twig' %}

{% block title %}Bandeja de proyectos{% endblock %}

{% block body %}
{% set filtros = {
    'atencion': ['Para gestionar', 'Pendientes de acción', dashboard.pendientes.sinPresupuesto + dashboard.pendientes.presupuestoBorrador + dashboard.resumen.entregados + dashboard.pendientes.aceptadosSinFactura + dashboard.pendientes.pendienteCobro],
    'presupuesto_borrador': ['Borradores', 'Por terminar', dashboard.resumen.presupuestoBorrador],
    'presupuesto_entregado': ['Entregados', 'Esperando respuesta', dashboard.resumen.entregados],
    'sin_presupuesto': ['Sin presupuesto', 'Pendientes de preparar', dashboard.pendientes.sinPresupuesto],
    'facturado_pendiente': ['Pendiente de cobro', 'Facturas abiertas', dashboard.resumen.pendienteCobro],
    'cerrado': ['Cerrados', 'Obras finalizadas', dashboard.resumen.cerrados]
} %}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Proyectos</h1>
            <p class="text-muted mb-0">Tu bandeja de trabajo. Selecciona una situación para ver los proyectos correspondientes.</p>
        </div>
        <a href="{{ path('app_proyecto_new') }}" class="btn btn-primary">Nuevo proyecto</a>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="row g-2">
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Presupuestado</div><div class="fw-bold">{{ dashboard.economico.totalPresupuestado|number_format(2, ',', '.') }} €</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Presupuestos</div><div class="fw-bold">{{ dashboard.resumen.presupuestoBorrador + dashboard.resumen.entregados }}</div><div class="small text-muted">borrador o entregados</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Aceptados</div><div class="fw-bold text-primary">{{ dashboard.resumen.aceptadoOConvertido }}</div><div class="small text-muted">aceptados o convertidos</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Cobrado</div><div class="fw-bold text-success">{{ dashboard.economico.totalCobrado|number_format(2, ',', '.') }} €</div></div></div>
                <div class="col-lg col-md-4 col-12"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Pendiente de cobro</div><div class="fw-bold text-danger">{{ dashboard.economico.totalPendienteCobro|number_format(2, ',', '.') }} €</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Coste confirmado</div><div class="fw-bold">{{ dashboard.economico.totalCosteConfirmado|number_format(2, ',', '.') }} €</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Coste pendiente</div><div class="fw-bold text-warning">{{ dashboard.economico.totalPendienteConfirmar|number_format(2, ',', '.') }} €</div></div></div>
                <div class="col-lg col-md-4 col-6"><div class="border rounded px-3 py-2 h-100"><div class="small text-muted">Margen estimado</div><div class="fw-bold {{ dashboard.economico.margenEstimado >= 0 ? 'text-success' : 'text-danger' }}">{{ dashboard.economico.margenEstimado|number_format(2, ',', '.') }} €</div></div></div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">
        {% for codigo, filtro in filtros %}
            <div class="col-xl-2 col-md-4 col-6">
                <a href="{{ path('app_dashboard', {situacion: codigo}) }}"
                   class="card h-100 text-decoration-none border {{ busqueda.situacion == codigo ? 'border-2 border-dark shadow-sm' : 'border-light shadow-sm' }}">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div><div class="small text-muted">{{ filtro[0] }}</div><div class="small text-muted">{{ filtro[1] }}</div></div>
                            <span class="fs-4 fw-bold text-dark">{{ filtro[2] }}</span>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
            <div>
                {% set filtroActual = filtros[busqueda.situacion] ?? ['Todos los proyectos'] %}
                <h2 class="h5 mb-0">{{ filtroActual[0] }}</h2>
                <div class="small text-muted">{{ busqueda.total }} proyecto{{ busqueda.total == 1 ? '' : 's' }} · página {{ busqueda.pagina }} de {{ busqueda.paginas }}</div>
            </div>
            <a href="{{ path('app_dashboard', {situacion: 'todos'}) }}" class="btn btn-sm btn-outline-secondary">Ver todos</a>
        </div>
        <div class="card-body border-bottom bg-light">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="situacion" value="{{ busqueda.situacion }}">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Proyecto</label>
                    <input type="search" name="nombre" class="form-control" value="{{ busqueda.nombre }}" placeholder="Nombre del proyecto">
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Cliente</label>
                    <input type="search" name="cliente" class="form-control" value="{{ busqueda.cliente }}" placeholder="Nombre o apellidos">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Teléfono</label>
                    <input type="search" name="telefono" class="form-control" value="{{ busqueda.telefono }}">
                </div>
                <div class="col-md-2 d-grid"><button class="btn btn-dark">Buscar</button></div>
            </form>
        </div>
        <div class="card-body p-0">
            {% if busqueda.resultados is empty %}
                <div class="p-4 text-muted">No hay proyectos en esta situación.</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-4">Proyecto</th><th>Situación</th><th>Importe</th><th>Coste pendiente</th><th>Margen estimado</th><th>Cobro</th><th class="text-end pe-4"></th></tr></thead>
                        <tbody>
                        {% for item in busqueda.resultados %}
                            {% set proyecto = item.proyecto %}
                            {% set etiquetas = {
                                'sin_presupuesto': ['Sin presupuesto', 'bg-secondary'],
                                'presupuesto_borrador': ['Borrador', 'bg-warning text-dark'],
                                'presupuesto_entregado': ['Entregado', 'bg-info text-dark'],
                                'aceptado_sin_factura': ['Aceptado · sin factura', 'bg-primary'],
                                'facturado_pendiente': ['Facturado · pendiente', 'bg-danger'],
                                'cerrado': ['Cerrado', 'bg-success'],
                                'en_proceso': ['En proceso', 'bg-primary']
                            } %}
                            {% set etiqueta = etiquetas[item.situacion] ?? ['En proceso', 'bg-primary'] %}
                            {% set pendiente = proyecto.totalFacturado|default(0) - proyecto.totalCobrado|default(0) %}
                            <tr>
                                <td class="ps-4"><div class="fw-semibold">{{ proyecto.nombre }}</div><div class="small text-muted">{% if proyecto.cliente %}{{ proyecto.cliente.nombreCl }} {{ proyecto.cliente.apellidosCl }}{% if proyecto.cliente.telefono1Cl or proyecto.cliente.telefono2Cl %}<span class="mx-1">·</span>{{ proyecto.cliente.telefono1Cl ?: proyecto.cliente.telefono2Cl }}{% endif %}{% else %}Sin cliente{% endif %}</div></td>
                                <td><span class="badge {{ etiqueta[1] }}">{{ etiqueta[0] }}</span></td>
                                <td><div class="fw-semibold">{{ (proyecto.totalFacturado ?: proyecto.totalPresupuestado)|default(0)|number_format(2, ',', '.') }} €</div><div class="small text-muted">{{ proyecto.totalFacturado ? 'Facturado' : 'Presupuestado' }}</div></td>
                                <td><div class="fw-semibold text-warning">{{ item.economico.costePrevistoPendiente|number_format(2, ',', '.') }} €</div><div class="small text-muted">sin IVA</div></td>
                                <td><div class="fw-semibold {{ item.economico.margenEstimado >= 0 ? 'text-success' : 'text-danger' }}">{{ item.economico.margenEstimado|number_format(2, ',', '.') }} €</div><div class="small text-muted">{{ item.economico.margenSobreVentas|number_format(1, ',', '.') }} %</div></td>
                                <td>{% if proyecto.totalFacturado %}<div class="fw-semibold {{ pendiente > 0 ? 'text-danger' : 'text-success' }}">{{ pendiente|number_format(2, ',', '.') }} €</div><div class="small text-muted">pendiente</div>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                                <td class="text-end pe-4"><a href="{{ path('app_proyecto_show', {id: proyecto.id}) }}" class="btn btn-sm btn-outline-primary">Abrir</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        {% if busqueda.paginas > 1 %}
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                {% set parametrosAnterior = {situacion: busqueda.situacion, nombre: busqueda.nombre, cliente: busqueda.cliente, telefono: busqueda.telefono, pagina: busqueda.pagina - 1} %}
                {% set parametrosSiguiente = {situacion: busqueda.situacion, nombre: busqueda.nombre, cliente: busqueda.cliente, telefono: busqueda.telefono, pagina: busqueda.pagina + 1} %}
                {% if busqueda.pagina > 1 %}
                    <a href="{{ path('app_dashboard', parametrosAnterior) }}" class="btn btn-sm btn-outline-secondary">Anterior</a>
                {% else %}
                    <span class="btn btn-sm btn-outline-secondary disabled">Anterior</span>
                {% endif %}
                <span class="small text-muted">Página {{ busqueda.pagina }} de {{ busqueda.paginas }}</span>
                {% if busqueda.pagina < busqueda.paginas %}
                    <a href="{{ path('app_dashboard', parametrosSiguiente) }}" class="btn btn-sm btn-outline-secondary">Siguiente</a>
                {% else %}
                    <span class="btn btn-sm btn-outline-secondary disabled">Siguiente</span>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
